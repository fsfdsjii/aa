function search(keyword,page)
	local pageNum = 0
	if type(tonumber(page)) == "number" then
		pageNum = page
	end
	script.Parent.SearchButton.Text = "Searching..."
	script.Parent.ScrollingFrame.CanvasSize = UDim2.new(0,0,0,0)
	script.Parent.ScrollingFrame.Canvas:ClearAllChildren()
	local source = game.HttpService:GetAsync("https://robloxacademia.000webhostapp.com/api/GetCatalog.php?category=5&page="..pageNum.."&keyword="..keyword)
	local json = game.HttpService:JSONDecode(source)
	local pos = -100
	for _, item in pairs(json) do
		local button = script.Item:Clone()
		button.AssetName.Text = item.Name
		button.AssetIcon.Image = "http://www.roblox.com/Game/Tools/ThumbnailAsset.ashx?fmt=png&wd=110&ht=110&aid="..item.AssetId
		pos = pos + 105
		button.Position = UDim2.new(0,9,0,pos)
		button.Visible = true
		button.Parent = script.Parent.ScrollingFrame.Canvas
		script.Parent.ScrollingFrame.CanvasSize = script.Parent.ScrollingFrame.CanvasSize + UDim2.new(0,0,0,105)
		button.MouseButton1Down:connect(function()
			insertTool(item.AssetId)
		end)
	end
	script.Parent.SearchButton.Text = "Search"
end
function insertTool(assetId)
	local myPlayer = script.Parent.Parent.Parent.Parent
	script.Parent.Parent.ProgressFrame.Visible = true
	script.Parent.Parent.ProgressFrame.AssetIcon.Image = "http://www.roblox.com/Game/Tools/ThumbnailAsset.ashx?fmt=png&wd=110&ht=110&aid="..assetId
	local insert = game:GetService("InsertService"):LoadAsset(assetId)
	script.Parent.Parent.ProgressFrame.Visible = false
	for _, tool in pairs(insert:GetChildren()) do
		tool.Parent = myPlayer.Backpack
	end	
end

script.Parent.SearchButton.MouseButton1Click:connect(function()
	search(script.Parent.KeywordBox.Text,script.Parent.PageBox.Text)
end)
end))
