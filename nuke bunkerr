			parts[x].Transparency = 1
		end

		illusion.Transparency =1
		illusion.Reflectance = 0
	end
	--------------------------------------------------------------
	function Oc()

		if ShieldVal == false then shields() else offed() end

	end

	script.Parent.Head.CD.MouseClick:connect(Oc)

	shields()



