table.insert(cors,sandbox(Script45,function()
currentTime = 60
maxTime = 200
minTime = 01

function setName()
	script.Parent.Name = "WIJ Nuclear Bomb Timer (S:2000): "..currentTime.." remaining"
end
setName()

function changeTime(button)
	if button.Name == "Add" then
		if currentTime < maxTime then
			currentTime = currentTime + 1
		end
	elseif button.Name == "Subtract" then
		if currentTime > minTime then
			currentTime = currentTime - 1
		end
	end
	setName()
