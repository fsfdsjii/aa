--// Functions
CFuncs = {
	Part=function(Parent,Size,Color,Material,Transparency,PartCFrame)
		local P = IN("Part",Parent)
		P.Size = Size
		P.Color = Color
		P.Material = Material
		P.Transparency = Transparency
		P.CFrame = PartCFrame
		return P
	end,
	Mesh=function(Parent,MeshType,MeshId,TextureId,Scale)
		local M = IN("SpecialMesh",Parent)
		M.MeshType = MeshType
		M.MeshId = MeshId
		M.TextureId = TextureId
		M.Scale = Scale
		return M
	end,
	Sound=function(Parent,SoundId,Volume,PlaybackSpeed)
		local S=IN("Sound",Parent)
		S.SoundId = SoundId
		S.Volume = Volume
		S.PlaybackSpeed = PlaybackSpeed
		S:Play()
		S.Played:Connect(function()
			S:Remove()
		end)
		return S
	end,
}
function waveslash(wtype,rotationx,rotationy,rotationz,rotyspeed,speed,growSize,cframe,color)
	if wtype == "Slash" then
		local Wave = IN("Part",Effects)
		Wave.Anchored = true
		Wave.CanCollide = false
		Wave.CFrame = cframe
		Wave.Color = color
		Wave.Orientation = VT(rotationx,rotationy,rotationz)
		Wave.CFrame=Wave.CFrame*angles(math.rad(0),math.rad(math.random(-360,360)),math.rad(0))
		local mesh = IN("SpecialMesh",Wave)
		mesh.MeshType = Enum.MeshType.FileMesh
		mesh.MeshId = "rbxassetid://662586858"
		mesh.Scale = VT(0.1,0.05,0.1)
		local rtx = coroutine.create(function()
			while Wave.Transparency < 1 do
				swait()
				mesh.Scale = mesh.Scale + VT(growSize,growSize/4.5,growSize)
				Wave.Transparency = Wave.Transparency + speed
				Wave.CFrame = Wave.CFrame*angles(math.rad(0),math.rad(rotyspeed),math.rad(0))
				if Wave.Transparency > 1 then
					Wave:Destroy()
				end
			end
		end)
		coroutine.resume(rtx)
		Wave.Destroying:Connect(function()
			coroutine.yield(rtx)
		end)
		return true
	end
end
function SelectionBox(Parent,Adornee,Color,Linethickness)
	if (Parent and Adornee and Color and Linethickness) ~= nil	 then
		local Selection = Instance.new("SelectionBox",Parent)
		Selection.Adornee = Adornee
		Selection.Color3 = Color
		Selection.LineThickness = Linethickness
		return Selection
	end
end
function sphereMK(bonuspeed,FastSpeed,type,pos,x1,y1,z1,value,color,outerpos)
	local type = type
	local rng = Instance.new("Part", Effects)
	rng.Anchored = true
	rng.CanCollide = false
	rng.FormFactor = 3
	rng.Name = "Ring"
	rng.Material = "Neon"
	rng.Size = Vector3.new(1, 1, 1)
	rng.Transparency = 0
	rng.TopSurface = 0
	rng.BottomSurface = 0
	rng.CFrame = pos
	rng.Color = color
	rng.CFrame = rng.CFrame + rng.CFrame.lookVector*outerpos
	local rngm = Instance.new("SpecialMesh", rng)
	rngm.MeshType = "Sphere"
	rngm.Scale = VT(x1,y1,z1)
	local scaler2 = 1
	local speeder = FastSpeed
	if type == "Add" then
		scaler2 = 1*value
	elseif type == "Divide" then
		scaler2 = 1/value
	end
	coroutine.resume(coroutine.create(function()
		for i = 0,10/bonuspeed,0.1 do
			swait()
			if type == "Add" then
				scaler2 = scaler2 - 0.01*value/bonuspeed
			elseif type == "Divide" then
				scaler2 = scaler2 - 0.01/value*bonuspeed
			end
			speeder = speeder - 0.01*FastSpeed*bonuspeed
			rng.CFrame = rng.CFrame + rng.CFrame.lookVector*speeder*bonuspeed
			rng.Transparency = rng.Transparency + 0.01*bonuspeed
			rngm.Scale = rngm.Scale + Vector3.new(scaler2*bonuspeed, scaler2*bonuspeed, 0)
		end
		rng:Destroy()
	end))
end
