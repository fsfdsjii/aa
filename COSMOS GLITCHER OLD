function FadePart(Part,Type,TypeSpeed,TransparencySpeed,Speed)
	if Part ~= nil then
		if Type == "Grow" then
			local Routine = coroutine.create(function()
				while Part.Transparency < 1 do
					swait(Speed)
					Part.Size = Part.Size + Vector3.new(TypeSpeed,TypeSpeed,TypeSpeed)
					Part.Transparency = Part.Transparency + TransparencySpeed
					if Part.Transparency > 1 then
						Part:Destroy()
					end
				end
			end)
			coroutine.resume(Routine)
			Part.Destroying:Connect(function()
				coroutine.yield(Routine)
			end)
		end
		if Type == "Shrink" then
			local Routine = coroutine.create(function()
				while Part.Transparency < 1 do
					swait(Speed)
					Part.Size = Part.Size - Vector3.new(TypeSpeed,TypeSpeed,TypeSpeed)
					Part.Transparency = Part.Transparency + TransparencySpeed
					if Part.Transparency > 1 then
						Part:Destroy()
					end
				end
			end)
			coroutine.resume(Routine)
			Part.Destroying:Connect(function()
				coroutine.yield(Routine)
			end)
		end
	end
end
