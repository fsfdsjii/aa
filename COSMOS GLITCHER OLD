		local randRotation3 = CFrame.Angles(math.random(), math.random(), math.random())
		part1.CFrame = part1.CFrame * randRotation1
		part2.CFrame = part2.CFrame * randRotation2
		part3.CFrame = part3.CFrame * randRotation3
		part1.Size = part1.Size + Vector3.new(0.01, 0.01, 0.01)
		part2.Size = part2.Size + Vector3.new(0.01, 0.01, 0.01)
		part3.Size = part3.Size + Vector3.new(0.01, 0.01, 0.01)
		part1.Transparency = part1.Transparency + 0.02
		part2.Transparency = part2.Transparency + 0.02
		part3.Transparency = part3.Transparency + 0.02
