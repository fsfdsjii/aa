function ShakeyShakey2(Times, Intensity, Left, Right) --Made by Tora#7935
	local pertick = tick()
	local Times = Times
	local Intensity = Intensity
	local ShakeLeft = math.cos(pertick * Times) * Intensity
	local ShakeRight = math.abs(math.sin(pertick * Times)) * Intensity
	local Left = Left
	local Right = Right
	local Shake = Vector3.new(
		if Left then ShakeLeft else ShakeRight, 0
	)
	local timeaccumalated = 0
	repeat swait(.5)
		Humanoid.CameraOffset = Humanoid.CameraOffset:lerp(Shake, Times)
		timeaccumalated = timeaccumalated + 1
	until timeaccumalated == Times
	--print("Decimal: 'Camera Shake' has been spinned "..timeaccumalated.. " Times!")
	swait(.5)
	Humanoid.CameraOffset = Vector3.new(0,0,0)
end
function ShakeyShakey(Times, Intensity, Range) --Also Made by Tora#7935
	local pertick = tick()
	local Times = Times
	local Intensity = Intensity
	local ShakeLeft = math.cos(pertick * Times) * Intensity
	local bobbleRight = math.abs(math.sin(pertick * Times)) * Intensity
	local Shake = Vector3.new(ShakeLeft, bobbleRight, 0)
	for i=1,Times do
		Humanoid.CameraOffset = Humanoid.CameraOffset:lerp(Shake, Intensity)
		swait()
		Humanoid.CameraOffset = Vector3.new(0,0,0)
	end
end
