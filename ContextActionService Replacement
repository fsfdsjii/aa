
pl1 = Instance.new("RemoteEvent",owner.PlayerGui)
pl2x = Instance.new("BindableEvent",owner.Character)
pl3x = Instance.new("BindableEvent",owner.Character)
pl2 = Instance.new("RemoteEvent",pl1)
ContextActionService = {
	LocalToolEquipped = pl2x.Event,
	LocalToolUnequipped = pl3x.Event,
  Name = "ContextActionService"
}
NLS([[Cont = game:GetService('ContextActionService')
pl1 = script.Parent
pl2 = script.Parent.RemoteEvent
pl1.OnClientEvent:Connect(function(prop,p1,p2,p3,p4,p5,p6)
pcall(Cont[prop], Cont,p1,p2,p3,p4,p5,p6)
if prop == "GetAllBoundActionInfo" then
pl2:FireServer(prop, Cont:GetAllBoundActionInfo())
end
if prop == "GetBoundActionInfo" then
pl2:FireServer(prop, Cont:GetBoundActionInfo(p1))
end
if prop == "GetCurrentLocalToolIcon" then
pl2:FireServer(prop, Cont:GetCurrentLocalToolIcon())
end
if prop == "GetButton" then
pl2:FireServer(prop, Cont:GetButton(p1))
end
end)
Cont.LocalToolEquipped:Connect(function(tool)
pl1:FireServer("pt1", tool)
end)
Cont.LocalToolUnequipped:Connect(function(tool)
pl1:FireServer("pt2", tool)
end)]],owner.PlayerGui).Parent = pl1

pl1.OnServerEvent:Connect(function(me, str, value)
	if str == "pt1" then
		pl2x:Fire(value)
	end
	if str == "pt2" then
		pl3x:Fire(value)
	end
end)

