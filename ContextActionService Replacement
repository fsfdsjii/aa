function ContextActionService:GetAllBoundActionInfo() : "Dictionary"
	pl1:FireClient(owner, "GetAllBoundActionInfo")
	tablez = {l = nil}
	pl2.OnServerEvent:Once(function(m, prop, value)
		if prop == "GetAllBoundActionInfo" then
			tablez.l = value
		end
	end)
	repeat task.wait() until tablez.l ~= nil
	return tablez.l
end
