--first? Robloxian radar script
--by chess123mate (c) 2008
--FEEL FREE TO DISTRIBUTE THIS CODE, BUT DO NOT CLAIM IT TO BE YOURS! Thanks
--NOTE: Much of this script is customizable/editable. Read carefully!

frequency=0.4 --how often to update. Decrease for better quality, increase to reduce lag.
