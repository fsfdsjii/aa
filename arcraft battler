x=radarWidth/worldWidth
z=radarDepth/worldDepth
y=radarHeight/worldHeight
factor=Vector3.new(x,y,z)
function transform(pos) --transform real-life object into radar coordinates
	x=(pos.x-worldCenter.x)*factor.x+originX
	y=(pos.y-worldCenter.y)*factor.y+originY
	z=(pos.z-worldCenter.z)*factor.z+originZ
	return Vector3.new(x,y,z)
end
function inRange(pos) --this pos MUST be the object[] pos, ie. where it should be on the radar.
	if pos.x<originX-radarWidth/2 or pos.x > originX+radarWidth/2 or pos.z<originZ-radarDepth/2 or pos.z > originZ+radarDepth/2 or pos.y<originY or pos.y>originY+radarHeight then
		return false
	else
		return true
	end
end

