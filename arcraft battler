			if color[getIndex(references[i].Parent.Name)]==1 then objects[i].BrickColor=references[i].BrickColor end
			if not inRange(objects[i].Position) then
				if humanoid[id] then objects[i].Parent.Humanoid.Parent=objects[i] end --compress it!
				objects[i].Parent=nil
				inWorkspace[i]=false
