function(script,require)
players_accounted = 0
players = {}
max_accounted = 3
teleporting = false
time_passed = 0

function pad_watch(tp_pad)
	if teleporting then
		return
	end
	local current_p = nil
	local db = false
	-- 248, 217, 109 // original foil colour
	-- foil // original foil material
	
	local function lock_player()
		players_accounted += 1
		table.insert(players,1,current_p)
		local bp = Instance.new('BodyPosition')
		if current_p.Character.HumanoidRootPart == nil then
			return
		end
		bp.Parent = current_p.Character.HumanoidRootPart
		bp.Name = 'Source_Position'
		bp.Position = tp_pad.Point.Position
		bp.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
		tp_pad.Foil.PointLight.Brightness = 0
		tp_pad.Foil.PointLight.Enabled = true
		tp_pad.Foil.Material = Enum.Material.Neon
		tp_pad.Foil.PointLight.Shadows = true
		game:GetService('TweenService'):Create(tp_pad.Foil,TweenInfo.new(1),{Color = Color3.fromRGB(250,250,250)}):Play()
		game:GetService('TweenService'):Create(tp_pad.Foil.PointLight,TweenInfo.new(1),{Brightness = 5}):Play()
		tp_pad.Foil.ParticleEmitter.Enabled = true
		tp_pad.Foil.Activate:Play()
		tp_pad.Occupied.Value = true
	end
	
	local function player_left()
		--warn('player left')
		players_accounted -= 1
		delay(0,function()
			local p = table.find(players,current_p)
			local c = 0
			for _, v in pairs(players) do
				c+= 1
				if v == current_p then
					table.remove(players,c)
				end
			end
		end)
		wait(.1)
		current_p = nil
		warn(players_accounted)
		tp_pad.Occupied.Value = false
	end
	
	tp_pad.Foil.Touched:connect(function(object)
		wait(.1)
		if object.Parent:FindFirstChild('Humanoid') 
			and current_p == nil 
			and not tp_pad.Occupied.Value 
			and game.Players:GetPlayerFromCharacter(object.Parent)
			and object.Parent.Humanoid.Health > 0
			and not db then
			if object.Parent.Humanoid.Health > 0 and not teleporting and not table.find(players,game.Players:GetPlayerFromCharacter(object.Parent))  then
				db = true
				current_p = game.Players:GetPlayerFromCharacter(object.Parent)
				lock_player()
			end
		else
			warn('req not met')
		end
	end)
	
	repeat wait(1)
		if current_p ~= nil then
			if current_p.Character.Humanoid.Health <= 0 or current_p == nil then
				player_left()
				break
			end
		else
		end
	until teleporting or current_p == nil and db == true
	warn('moving on')
	delay(0.4,function()
		repeat wait()
			
		until teleporting == false or current_p == nil
		warn('recharged')
		tp_pad.Foil.Material = Enum.Material.Foil
		game:GetService('TweenService'):Create(tp_pad.Foil,TweenInfo.new(1),{Color = Color3.fromRGB(248, 217, 109)}):Play()
		game:GetService('TweenService'):Create(tp_pad.Foil.PointLight,TweenInfo.new(1),{Brightness = 0}):Play()
		tp_pad.Foil.ParticleEmitter.Enabled = false
		tp_pad.Occupied.Value= false
		delay(0.2,function()
			db = false
		end)
	end)
end

function TeleportPeople()
	teleporting = true
	time_passed = 0
	script.Parent.JesuStat.jesusface.SoundII:Play()
	wait(2)
	delay(0,function()
		for i = 5,0,-1 do
			wait(.8)
			game:GetService('TweenService'):Create(script.Parent.JesuStat.lneo,TweenInfo.new(1),{Transparency = 0.7}):Play()
			wait(.65)
			game:GetService('TweenService'):Create(script.Parent.JesuStat.lneo,TweenInfo.new(1),{Transparency = 1}):Play()
			wait(.76)
		end
	end)
	game:GetService('TweenService'):Create(script.Parent.JesuStat.CFramePart,TweenInfo.new(3),
	{CFrame = CFrame.new(script.Parent.JesuStat.CFramePart.Position,
		script.Parent.JesuStat.LookHere.Position)}):Play()
	wait(4)
	game:GetService('TweenService'):Create(script.Parent.JesuStat.CFramePart,TweenInfo.new(.6),
	{CFrame = CFrame.new(script.Parent.JesuStat.CFramePart.Position,
		script.Parent.JesuStat.ThenLookHere.Position)}):Play()
	script.Parent.NotifyEvent:Fire(players)
	--[[
		for _, v in pairs(players) do
		wait(.1)
		delay(0,function()
			v.Character.HumanoidRootPart.Source_Position.Position += Vector3.new(0,2500,0)
		end)
		delay(1,function()
			game:GetService('TeleportService'):Teleport(6739715210,v)
		end)
	end
	]]
	for _, v in pairs(players) do
		wait(.1)
		delay(0,function()
			v.Character.HumanoidRootPart.Source_Position.Position += Vector3.new(0,2500,0)
		end)
	end
	local success, result = pcall(function()
		return game:GetService('TeleportService'):TeleportPartyAsync(6739715210,players)
	end)

	if success then
		local jobId = result
		--print("Players teleported to "..jobId)
	else
		--warn(result, 'resorting to manual teleportation')
		delay(0,function()
			for _, v in pairs(players) do
				delay(1,function()
					game:GetService('TeleportService'):Teleport(6739715210,v)
				end)
			end
		end)
	end
	
	delay(0,function()
		for _, v in pairs(players) do
			table.remove(players,1)
		end 
	end)
	players_accounted = 0
	wait(10)
	game:GetService('TweenService'):Create(script.Parent.JesuStat.CFramePart,TweenInfo.new(3),
	{CFrame = CFrame.new(script.Parent.JesuStat.CFramePart.Position,
		script.Parent.JesuStat.FinallyLookHere.Position)}):Play()
	wait(4.2)
	teleporting = false
	players_accounted = 0
	wait(1)
end


for _, v in pairs(script.Parent.Pads:GetChildren()) do
	delay(0,function()
		pad_watch(v)
	end)
end



while wait(1) do
	if players_accounted <= max_accounted and players_accounted >= 1 then
		time_passed += 1
		if time_passed > 10 then
			TeleportPeople()
			wait(2)
			for _, v in pairs(script.Parent.Pads:GetChildren()) do
				delay(0,function()
					pad_watch(v)
				end)
			end
		end
	else
		time_passed = 0
	end
end
end,
