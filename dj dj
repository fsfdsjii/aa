	local mp = script.Parent.Parent.MusicPlayerB

	local paused = script.Parent.TrackPaused

	local button = script.Parent.Pause

	function Track()

		track_current = script.Parent.TrackCurrent.Value

		local track_prev = script.Parent.TrackPrev.Value

		if track_current ~= 0 then
			mp["Track" ..track_current]:Play()
			if track_prev ~= track_current then
				mp["Track" ..track_prev]:Stop()
				paused.Value = false
			end
		else
			mp["Track" ..track_prev]:Stop()
			paused.Value = false
		end

	end

	function Pause()

		if paused.Value == true then
			mp["Track" ..track_current]:Pause()
			button.Mesh.Offset = Vector3.new(0, -0.08, 0)
			button.Icon.Texture = "http://www.roblox.com/asset/?id=210391009"
		else
			if track_current ~= 0 then
				mp["Track" ..track_current]:Resume()
			end
			button.Mesh.Offset = Vector3.new(0, 0, 0)
			button.Icon.Texture = "http://www.roblox.com/asset/?id=210391071"
		end

	end

	script.Parent.TrackCurrent.Changed:connect(Track)
	paused.Changed:connect(Pause)

end))
