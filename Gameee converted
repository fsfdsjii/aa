local function GetNearestPlayer()
	local closest_part = nil
	local closest_distance = MAX_LOOK_DISTANCE
	for _, player in ipairs(Players:GetPlayers()) do
		local part = player.Character and player.Character:FindFirstChild("Head")
		if part then
			local distance = (part.Position - DefaultPosition).Magnitude
			if distance < closest_distance then
				closest_distance = distance
				closest_part = part
			end
		end
	end
	return closest_part
end

local current_cframe = DefaultCFrame
local focused_part = nil
local last_check = 0

RunService.Heartbeat:Connect(function(delta)
	local new_cframe = DefaultCFrame
	if focused_part then
		new_cframe = CFrame.lookAt(
			DefaultPosition,
			focused_part.Position
		)
	end
	current_cframe = current_cframe:Lerp(
		new_cframe,
		math.clamp(delta * LERP_SPEED, 0, 1)
	)
	MainSphere.CFrame = current_cframe
	for part, offset in pairs(Parts) do
		part.CFrame = current_cframe * offset
	end
	if time() > last_check then
		last_check = time() + 5
		focused_part = GetNearestPlayer()
	end
end)

MainSphere.Anchored = true
