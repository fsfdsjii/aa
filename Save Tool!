local function QHJW_fake_script() -- TextButton.Script 
	local script = Instance.new('Script', TextButton)

	script.Parent.MouseButton1Click:Connect(function()
		tool = owner.Character:FindFirstChildOfClass('Tool')
		tool2 = script.Parent:FindFirstChildOfClass('Tool')
		if tool2 then
			if not tool then
			tool2.Parent = owner.Character
			script.Parent.Text = "Equip Tool Then Save Here."
			script.Parent.ImageLabel.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
			end
		end
		if tool then
		if not tool2 then
			print(tool2)
			tool.Parent = script.Parent
			script.Parent.Text = tool.Name
			script.Parent.ImageLabel.Image = tool.TextureId
			end
		end
	end)
end
coroutine.wrap(QHJW_fake_script)()
