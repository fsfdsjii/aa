local TweenService = game:GetService("TweenService")

local part = Instance.new("Part")
part.Position = Vector3.new(0, 10, 0)
part.Color = Color3.new(1, 0, 0)
part.Anchored = true
part.Parent = game.Workspace
part.Size = Vector3.new(5, 5, 5)
for i,v in game.Players:GetPlayers() do
character = game.Players:GetPlayers()[math.random(1, i)].Character
if character ~= nil then
humr = character:FindFirstChild('HumanoidRootPart')
if humr then
part.Orientation = humr.Orientation
end
end
end

local Mesh = Instance.new("SpecialMesh",part)
Mesh.MeshId = "rbxassetid://6789346871"
Mesh.Scale = Vector3.new(0.25, 0.25, 0.25)
Mesh.TextureId = "rbxassetid://6789350786"
Mesh.MeshType = Enum.MeshType.FileMesh

local goal = {}
for i,v in game.Players:GetPlayers() do
character = game.Players:GetPlayers()[math.random(1, i)].Character
if character ~= nil then
humr = character:FindFirstChild('HumanoidRootPart')
if humr then
goal.Position = humr.Position
goal.Orientation = humr.Orientation + humr.Orientation
end
end
end

local tweenInfo = TweenInfo.new(5)

local tween = TweenService:Create(part, tweenInfo, goal)

tween:Play()

tween.Completed:Connect(function()
for i,v in workspace:GetPartBoundsInBox(part.CFrame + Vector3.new(3, 3, 3), part.Size + Vector3.new(3, 3, 3)) do
if v ~= nil then
hum = v.Parent:FindFirstChildOfClass('Humanoid')
if hum then
hum.Health = 0
end
        end
    end
end)
