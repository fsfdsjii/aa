		script.Parent.Bulb.Material = Enum.Material.SmoothPlastic
		script.Parent.Shade.Material = Enum.Material.SmoothPlastic
		script.Parent.Interactive.CFrame = script.Parent.Interactive.CFrame * CFrame.new(0,-0.015,0)
		wait(0.1)
