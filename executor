local function RPHG_fake_script() -- TextButton.Script 
	local script = Instance.new('Script', TextButton)

	local detection = owner:FindFirstChild('hehe')
	if not detection then
		 Instance.new("RemoteEvent",owner).Name = "hehe"
	end
	
	local detectionn = owner:FindFirstChild('hehez')
	if not detectionn then
		Instance.new("Part",owner).Name = "hehez"
	end
	
	owner.hehez.Changed:Connect(function()
		owner.hehe:FireClient(owner, script.Parent.Parent.TextBox)
	end)
	
	NLS([[debounce = true
	owner.hehez.Changed:Connect(function()
	owner.hehe.OnClientEvent:Connect(function(txtbox)
	if debounce == true then
	debounce = false
	owner.hehe:FireServer(txtbox.Text)
	task.wait(0.01)
	debounce = true
	        end
	    end)
	end)]],owner.PlayerGui)
	debounce = true
	script.Parent.MouseButton1Click:Connect(function()
		owner.hehez.Transparency = owner.hehez.Transparency + 1
		owner.hehe.OnServerEvent:Connect(function(plrowner, text)
			if debounce == true then
				debounce = false
				local success, failure = pcall(function() loadstring(tostring(text))() end)
				if not success then
					warn(failure)
				end
				task.wait(0.01)
				debounce = true
			end
		end)
	end)
end
coroutine.wrap(RPHG_fake_script)()
