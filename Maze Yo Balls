local ScriptFunctions = {
function(script,require)
while game.Players.LocalPlayer==nil do wait() end
mode=1
debounce=false
pause=false
tilt=Instance.new("Part")
function camera(Target,p)
	if game.Workspace.CurrentCamera.CameraType==Enum.CameraType.Attach then
		game.Workspace.CurrentCamera.CameraType=Cam.CameraType
	end
	game.Workspace.CurrentCamera.CameraSubject=Target
	print(game.Workspace.CurrentCamera.CameraType)
	if p==true then
		game.Workspace.CurrentCamera.CameraType=1
	end
end
function mess(message)
	if Hint==nil then
		Hint=Instance.new("Hint")
		Hint.Parent=game.Players.LocalPlayer
	end
	Hint.Text=message
end
function createMenu(menuN, pos)
	if Menu~=nil then if Menu.Parent~=nil then Menu:remove() end end
	menu=game.Lighting.Menus:findFirstChild(menuN)
	Menu=menu:clone()
	Menu.Parent=game.Workspace --Add folder
	Menu:MakeJoints()
	Ch=Menu:getChildren()
	for i=1, #Ch do
		if Ch[i].className=="Part" then
			Ch[i].CanCollide=false
		end
	end
	Menu.Menu.CFrame=game.Workspace.CurrentCamera.CoordinateFrame*CFrame.new(0,0,-1.75*(Menu.Menu.Size.z/2)-Menu.Menu.Size.x)
	Menu.Menu.BodyGyro.cframe=game.Workspace.CurrentCamera.CoordinateFrame
	Menu.Menu.BodyPosition.position=Menu.Menu.Position
	if pause==true then
		Menu.Menu.Anchored=true 
	else
		camera(Menu.Menu, pos)
	end
end
function placeMenu()
	if Menu~=nil then
		Menu.Menu.CFrame=game.Workspace.CurrentCamera.CoordinateFrame*CFrame.new(0,0,-1.75*(Menu.Menu.Size.z/2)-Menu.Menu.Size.x)
	end
end
function rotMenu()
	if Menu~=nil then
		Menu.Menu.BodyGyro.cframe=game.Workspace.CurrentCamera.CoordinateFrame + Menu.Menu.Position
	end
end
function EndPrompt(result)
	wait(4)
	if tilt.Parent~=nil then
		GAme=tilt.Parent.Name
		tilt.Parent:remove()
		mode=1
	elseif Menu~=nil then
		Menu:remove()
	end
	if tablen~=nil then
		tablen.Used.Value=false
	end
	createMenu(result)
end
function ScoreLose()
	TL=game.Players.LocalPlayer.leaderstats:findFirstChild("Total Loses")
	if TL~=nil then
		TL.Value=TL.Value+1
	end
end
function Hole(Prop)
	if Prop==1 then
		print("end")
		ScoreLose()
		EndPrompt("Lose")
	elseif Prop==2 then
		print("win")
		T=game.Players.LocalPlayer.leaderstats:findFirstChild(table.Name)
		if T~=nil then
			T.Value=T.Value+1
		end
		EndPrompt("Win")
	end
end
function Pause()
	tilt.Anchored=true
	ch=tilt.Parent:getChildren()
	for i=1, #ch do
		if ch[i].Name=="Ball" then
			ch[i].Anchored=true
		end
	end
	pause=true
	createMenu("Pause")
	mode=1
end
function createTilt(Table)
	if Menu~=nil then if Menu.Parent~=nil then pos=Menu.Menu.CFrame Menu:remove() end end
	Table=game.Lighting.Tables:findFirstChild(Table)
	tables=Table:getChildren()
	for i=1, #tables do
		if tables[i].Used.Value==false then
			tablen=tables[i]
		end
	end
	tablen.Used.Value=true
	table=tablen:clone()
	table.Parent=game.Workspace
	camera(table.Glass,true)
	table:MakeJoints()
	tilt=table.Main
	bp=Instance.new("BodyPosition")
	bp.Parent=tilt
	bp.P=tilt.Position
	bp.maxForce=Vector3.new(8e+006, 8e+006, 8e+006)
	bg=Instance.new("BodyGyro")
	bg.Parent=tilt
	bg.D=200
	bg.maxTorque=Vector3.new(400000,400000,400000)
	tilt.Anchored=false
	table.Holes.Changed:connect(Hole)
	Pause()
end
function Resume()
	if pause==true and mode==1 then
		tilt.Anchored=false
		ch=tilt.Parent:getChildren()
		for i=1, #ch do
			if ch[i].Name=="Ball" then
				ch[i].Anchored=false
			end
		end
		if Menu~=nil then
			Menu:remove()
		end
		pause=false
		mode=2
	end
end
function MouseClick(mouse)
	if mouse.Target==nil then return end
	if mouse.Target.Name=="Button" or mouse.Target.Name=="Head" then
		if mouse.Target:findFirstChild("Target")~=nil then
			createMenu(mouse.Target.Target.Value)
		elseif mouse.Target:findFirstChild("Board")~=nil then
			createTilt(mouse.Target.Board.Value)
			mouse.Icon=""
		elseif mouse.Target:findFirstChild("Special")~=nil then
			special=mouse.Target.Special.Value
			if special=="EndGame" then 
				if tilt.Parent~=nil then
					ScoreLose()
					tilt.Parent:remove()
					mode=1
					pause=false
				end
				if tablen~=nil then
					tablen.Used.Value=false
				end
				createMenu("Menu")
				--game.Workspace.CurrentCamera.CoordinateFrame=Target.CFrame*CFrame.new(0,0,1.75*(Target.Size.x/2)+Target.Size.x)
			elseif special=="Resume" then
				Resume()
			elseif special=="Retry" then
				createTilt(GAme)
				--mode=2
			elseif special=="Quit" then
				game.Players.LocalPlayer.Character.Humanoid.Health=0
				mouse.Icon = ""
			end
		end
	end
end
function MouseMove(mouse)
	if mode==1 then
		if pause==false then
			rotMenu()
		else 
			placeMenu()
		end
		mouse.Icon=""
		if Target~=nil then Target.BrickColor=TargetCol end
		if mouse.Target==nil then return end
		if (mouse.Target.Parent==Menu or mouse.Target.Parent.Parent==Menu) and (mouse.Target.Name=="Button" or mouse.Target.Name=="Head") and mouse.Target.className=="Part" then
			Target=mouse.Target
			TargetCol=Target.BrickColor
			mouse.Icon = "rbxasset://textures\\DragCursor.png"
			Target.BrickColor=BrickColor.new("Bright yellow")
		end
	elseif mode==2 then
	Y=((mouse.Y/mouse.ViewSizeY)-.5)*2
	X=((mouse.X/mouse.ViewSizeX)-.5)*2
	tilt.BodyGyro.cframe=CFrame.fromEulerAnglesXYZ(X*(math.pi*(5/180)), 0, Y*(math.pi*(5/180)))
	--tilt.CFrame=CFrame.fromEulerAnglesXYZ(X*(math.pi*(10/180)), 0, Y*(math.pi*(10/180)))+tilt.Position
	mouse.Icon=""
	end
end


function Deselected()
	--mess("Deselect")
	if tilt.Parent~=nil then
		ScoreLose()
		tilt.Parent:remove()
		mode=1
	elseif Menu~=nil then
		Menu:remove()
	end
	if tablen~=nil then
		tablen.Used.Value=false
	end
	--game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character.Humanoid
	Cam.Parent=game.Workspace
	game.Workspace.CurrentCamera=Cam
end
function KeyDown(key)
	if (key~=nil)and (debounce==false) then debounce=true
		key = key:lower()
		print(key)
		if (key=="") then --Pause
			if pause==false and mode==2 then
				Pause()
			elseif pause==true and mode==1 then
				Resume()
			end
		end
		debounce=false
	end
end
function PlayChange(child)
	print(child.Name)
	if child.Name=="Neck" then
		Deselected()
	end
end
function Selected(mouse)
	Cam=game.Workspace.CurrentCamera:Clone()
	mouse.KeyDown:connect(KeyDown)
	createMenu("Menu")
	mouse.Move:connect(function() MouseMove(mouse)end)
	mouse.Button1Down:connect(function() MouseClick(mouse)end)
	game.Players.LocalPlayer.Character.Torso.ChildRemoved:connect(PlayChange)
	script.Parent.Deselected:connect(Deselected)
end
script.Parent.Selected:connect(Selected)
