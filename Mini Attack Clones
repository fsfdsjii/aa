    end
owner.Character.Archivable = true
owner.NotAFind.OnServerEvent:Connect(function(plr, targz)
if targz ~= nil then
hum = targz.Parent:FindFirstChildOfClass('Humanoid')
if hum then
for i,v in script:GetDescendants() do
if v.Name == owner.Character.Name then
v.Humanoid.WalkToPoint = targz.Position
v.Humanoid.WalkToPart = targz
v.Humanoid:MoveTo(targz.Position, targz)
v.HumanoidRootPart.Touched:Connect(function(part)
huma = part.Parent:FindFirstChildOfClass('Humanoid')
if huma then
if huma == hum then
if huma.Parent.HumanoidRootPart.Size == Vector3.new(1, 1, 0.5) then
huma:TakeDamage(40)
              end
              end
              end
              end)
              end
              end          
           end
        end
    end)
end)

e.Unequipped:Connect(function()
iden = script:FindFirstChild(owner.Character.Name)
if iden then
for i,v in script:GetDescendants() do
if v.Name == owner.Character.Name then
v:Destroy()
            end
        end
    end
end)

e.Equipped:Connect(function()
iden = script:FindFirstChild(owner.Character.Name)
if not iden then
for i,v in owner.Character:GetDescendants() do
v.Archivable = true 
    end
owner.Character.Archivable = true
for i = 1,tonumber(owner.NotAFindx.Value) do
