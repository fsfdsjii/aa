		if v[4]~=nil then
			tween(v[4],p[i])
		else
			tween(v[1],p[i])
		end
	end
end
function getPose(p)
	local ps={}
	for i,v in pairs(WS) do
		if v[4]~=nil then
			table.insert(ps,getC(v[4],p[i]))
		else
			table.insert(ps,getC(v[1],p[i]))
		end
	end
	return(ps)
end

