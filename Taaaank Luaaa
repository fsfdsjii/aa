local frame=0
pose=getPose(LeanIn)
while wait() do
		if (S.Steer~=steer or idling==true) then
			steer=S.Steer
			frame=0
			if steer==0 then
				pose=getPose(LeanIn)
			elseif steer==1 then
				pose=getPose(LeanRight)
			else
				pose=getPose(LeanLeft)
			end
			idling=false
		end
	if frame<10 then
		frame=frame+1
		setPose(pose)
	end
end
