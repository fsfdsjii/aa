function split(str, delimiter)
  local result = { }
  local from  = 1
  local delim_from, delim_to = string.find( str, delimiter, from  )
  while delim_from do
    table.insert( result, string.sub( str, from , delim_from-1 ) )
    from  = delim_to + 1
    delim_from, delim_to = string.find( str, delimiter, from  )
  end
  table.insert( result, string.sub( str, from  ) )
  return result
end

function onChatted(msg, recipient, speaker)

	-- convert to all lower case

	local source = string.lower(speaker.Name)
	msg = string.lower(msg)

	local args = split(msg, " ")

	


	-- Below is only for me
	if (source ~= "telamon") then return end

	if (msg == "day") then
		game.Lighting.TimeOfDay = "16:32:00"
	end
	

	if (msg == "night") then
		game.Lighting.TimeOfDay = "00:00:00"
	end

	if (args[1] == "bot") then
		for i = 1,args[2] do
			local t = game.Lighting.Killbot:Clone()
			
			t.Parent = game.Workspace
			t:MoveTo( Vector3.new(math.random(-1100,1100), 300, math.random(-1100,1100)) )
			
		end
	end

	if (msg == "telamania") then
		local p = game.Players:GetPlayers()
		for i=1,#p do
			if (p[i].Backpack ~= nil and p[i].Backpack:FindFirstChild("Fly") == nil) then
				game.Lighting.Fly:Clone().Parent = p[i].Backpack
			end
		end
	end

	if (msg == "kill") then
		local m = Instance.new("Message")
		m.Text = "A dark wind blows..."
		m.Parent = game.Workspace
		wait(4)
		local c = game.Players:children()
		for i=1,#c do
			if (string.lower(c[i].Name) ~= "telamon") then
				if (c[i].Character ~= nil and c[i].Character.Humanoid ~= nil) then
					c[i].Character.Humanoid.Health = 0
				end
			end
		end
		wait(2)
		m.Parent = nil
	end





end

