	--[[ By: Joe_1447. ]]--
	local AdvancedRespawnScript=script;
	repeat Wait(0)until script and script.Parent and script.Parent.ClassName=="Model";
	local Adam=AdvancedRespawnScript.Parent;
	local GameDerbis=Game:GetService("Debris");
