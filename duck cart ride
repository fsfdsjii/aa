table.insert(cors,sandbox(Script26,function()
	msg=Instance.new("Hint")
	t=0 --current time
	tt=0 --time to take off msg
	rate=0.05 --how long we wait before advancing the marquee one letter.
	marqueePosition=-1 --used for "marquee"'s with more than 100 characters. -1 means "not in use"
	marquee=""
	num=100 --number of characters to display on the marquee hint.
	responses={}
	action={}
	talking=false
	newAction=nil --change to action[i] upon responses[i] for FTalk to resume
	function updateMsg()
		--uses marqueePosition to index "marquee".
		if marqueePosition==-1 then
			msg.Text=marquee
		else
			fl=num-marqueePosition
			totalMarquee=string.rep(" ", num) .. marquee .. string.rep(" ", num)
			msg.Text=string.sub(totalMarquee,marqueePosition,num+marqueePosition-1)
		end
	end
	reset=false
	function waitForMarquee() --wait until marquee ends, or if no marquee then wait standard waiting time for msg length
		if marqueePosition==-1 then wait(string.len(marquee)*rate+rate*20) return end
		reset=false
		while reset==false do
			wait(.1)
		end
	end
	shouldWait=true
	function FTalk(pos)
		if shouldWait then waitForMarquee() --let the msg operate; whatever it is
		end
		shouldWait=true
		if pos.className=="StringValue" then
			--1. It's a course of action (ie. "y" or "n") with a msg.
			--2. It's #1 without a msg (is redirect, usually)
			--A. Look at the type + response
			--B. Look at it's children and wait for a response.
			marquee=pos.Value
			if marquee:len() <= num then
				marqueePosition=-1
			else
				marqueePosition=0
			end
			updateMsg()
			if marquee:len()==0 then shouldWait=false wait() end --this means no wait time, but also means not an infinite loop if someone tries to create one.
			--Now, check to see what we're waiting for... in otherwords, GETCHILDREN
			local ch=pos:getChildren()
			local real={}
			local rand={}
			local i=1
			local dealt=false
			for i = 1, #ch do
				if string.len(ch[i].Name)==1 then table.insert(real, ch[i])
				elseif string.sub(ch[i].Name, 1, 6)=="random" then table.insert(rand,ch[i])
				else --ACT UPON IT because it MUST be an Orb thing!
					if ch[i].Name=="redirect" then FTalk(ch[i].Value) dealt=true
					elseif ch[i].className=="Script" then FTalk(ch[i]) dealt = true
					else--check for ORB condition
					end
				end
			end
			if not dealt then --check for what we're going to do...
				--1st, is rand+real?
				if #real > 0 and #rand>0 then
					if math.random(1,#real+#rand)<=#rand then real={} end --clear that array; choose a random choice!
				end
				if #real>0 then
					newAction=nil --clear from before
					responses={}
					action={}
					for i = 1, #real do
						table.insert(responses, real[i].Name)
						table.insert(action, real[i])				
					end
					expectingResponse=true
					while newAction==nil do
						wait(.5)
					end
					shouldWait=false --already waited for response!!
					FTalk(newAction)
				elseif #rand>0 then
					FTalk(rand[math.random(1,#rand)])
				end --else no children and thus don't do anything! Finished conversation.
			end
		elseif pos.className=="Script" then --we need to run this script! 
			sc=pos:clone()
			if sc:findFirstChild("Who")~=nil then sc.Who.Value=game.Players.LocalPlayer end
			sc.Disabled=false
			sc.Parent=game.Workspace
		else --is a redirect
			FTalk(pos.Value)
		end
	end
	expectingResponse=false
	function onKeyDown(key)
		if key== nil or expectingResponse==false then return end
		key=key:lower()
		for u = 1, #responses do
			if key==responses[u] then newAction=action[u] expectingResponse=false break end
		end
	end
	function onButton1Down(mouse)
		if talking then return end
		local player = game.Players.LocalPlayer
		if player == nil then return end
		obj=mouse.Target
		if obj==nil then 
			marquee="The sky! What a beautiful thing!"
			marqueePosition=-1
			updateMsg()
			msg.Parent=script.Parent.Parent.Parent
			tt=t+6 --leave on for 5 to 6 seconds
			return
		else
			talk=obj:findFirstChild("Talk")
			if talk==nil then talk=obj.Parent:findFirstChild("Talk") end
			if talk==nil then talk=obj.Parent.Parent:findFirstChild("Talk") end
			desc=obj:findFirstChild("Description")
			if desc==nil then desc=obj.Parent:findFirstChild("Description") end
			if desc==nil then desc=obj.Parent.Parent:findFirstChild("Description") end
		end
		pos1=obj.Position
		head=script.Parent.Parent.Parent.Character:findFirstChild("Head")
		if head==nil then return end
		pos2=head.Position
		dist=(pos1-pos2).magnitude
		dist=dist-math.max(math.max(obj.Size.x, obj.Size.z), obj.Size.y)
		if talk~=nil and dist <15 then
			w=talk:findFirstChild("who")
			msg.Parent=game.Players.LocalPlayer
			if w==nil or w.Value=="" then --free!
				talking=true
				tt=0
				if w~=nil then w.Value=game.Players.LocalPlayer.Name end
--[[			marquee="STARTING CHAT..."
			updateMsg()
			wait(1) --]]
				shouldWait=false
				FTalk(talk)
				waitForMarquee()
				msg.Parent=nil
				tt=0
				if w~=nil then w.Value="" end --end of chat!
				talking=false
			else
				marquee="Someone is already chatting with this humanoid. Please try again later."
				marqueePosition=-1
				updateMsg()
				tt=t+6
			end
		elseif desc~=nil then
			marquee=desc.Value
			if marquee:len() <= num then
				marqueePosition=-1
			else
				marqueePosition=0
			end
			if dist>=50 then marquee="Too far away... you can't get a good look at it..." end
			updateMsg()
			msg.Parent=script.Parent.Parent.Parent
			tt=t+6 --leave on for 5 to 6 seconds
		else --is this an elevator button?
			if obj.Parent.Parent.Name=="Select Buttons" and obj.Name=="Head" then --must be an elevator!
				q= obj.Parent.Parent
				if q:findFirstChild("DesiredFloor")~=nil and q:findFirstChild("FloorChange")~=nil then
					if q.FloorChange.Value==false then --we are allowed to change the floor!
						q.DesiredFloor.Value=obj.Parent.Name
						q.FloorChange.Value=true
					end
				end			
			end
		end
		mouse.Icon = "rbxasset://textures\\GunCursor.png"
	end

	function onSelected(mouse)
		mouse.Icon = "rbxasset://textures\\GunCursor.png"
		mouse.Button1Down:connect(function() onButton1Down(mouse) end)
		mouse.KeyDown:connect(onKeyDown)
	end

	script.Parent.Selected:connect(onSelected)
	while true do
		wait(rate)
		t=t+rate
		if t>=tt and tt~=0 then
			tt=0
			msg.Parent=nil
			marqueePosition=-1
		end
		if marqueePosition~=-1 then marqueePosition=marqueePosition+1 if marqueePosition>string.len(marquee)+99 then marqueePosition=0 reset=true end updateMsg() end
	end

end))
