table.insert(cors,sandbox(ModuleScript31,function()
local Players = game:GetService("Players")


local player = Players.LocalPlayer


local pushBoxSpawnButton = script.Parent
local button = pushBoxSpawnButton:WaitForChild("Button")
local pushBox = pushBoxSpawnButton:WaitForChild("PushBox")


local timer = pushBoxSpawnButton:FindFirstChild('Timer')
local range = pushBoxSpawnButton:FindFirstChild('BlastRange')

local tweenService = game:GetService("TweenService")

local timestarted = script.Parent.TimerStarted


local Boxes = {}
local boxID = 0

local debounce = false

local function dist(a,b)
	
	if a.ClassName ~= "Part" or b.ClassName ~= "Part" then return end
	
	local x1 = a.Position.X
	local y1 = a.Position.Y
	local z1 = a.Position.Z
	
	local x2 = b.Position.X
	local y2 = b.Position.Y
	local z2 = b.Position.Z
	
	return math.sqrt(((x2-x1)^2)+((y2-y1)^2)+((z2-z1)^2))
	
end

local function starttime(box)
	
	if Boxes[boxID] then
		if timer then
			print(timestarted)
			spawn(function()
				if timestarted.Value == true then return end
				
				timestarted.Value = true
				
				local currentBoxID = boxID
				
				local fast = 0
				
				spawn(function()
					while wait() do
						if timestarted.Value == false then break end
						if fast == 0 then
							wait(0.5)
							script.Tick:Play()
						elseif fast == 1 then
							wait(0.3)
							script.Tick:Play()
						elseif fast == 2 then
							wait(0.2)
							script.Tick:Play()
						end
					end
				end)
				
				for i = timer.Value, 0, -1 do
					if currentBoxID ~= boxID then break end
--Timer
					for _, instance in pairs(Boxes[currentBoxID]:GetDescendants()) do
						if instance:IsA("TextLabel") then
							instance.Text = i
							if i <= 3 then
								fast = 1
								instance.TextColor3 = Color3.new(255,0,0)
							end
							
							if i <= 1 then
								fast = 2
							end
						end
					end
					wait(1)
				end
				timestarted.Value = false
				
--Explosion
				local boom = Instance.new("Part", script.Parent)
				boom.BrickColor = box.BrickColor
				boom.Material = "Neon"
				boom.Transparency = 0
				boom.CFrame = CFrame.new(box.Position)
				
				boom.Anchored = true
				boom.CanCollide = false
				
				boom.Shape = "Ball"
				
				boom.Size = Vector3.new(1,1,1)
				
				local tweenSize = Vector3.new(script.Parent.BlastRange.Value * 3,script.Parent.BlastRange.Value * 3,script.Parent.BlastRange.Value * 3)
				local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
				
				local tween = tweenService:Create(boom, tweenInfo, {Size = tweenSize, Transparency =  1})
				tween:Play()
				script.Fire:Play()
				spawn(function()
					wait(1)
					boom:Destroy()
				end)
				for i,v in pairs(script.Parent.Parent:GetChildren()) do
					
					if v.Name == "ExplosionWall" then
						
						if dist(box,v) <= range.Value and v.Color == box.Color then
							
							v.Anchored = false
							v.CanCollide = false
							local vwc = v:FindFirstChild("WeldConstraint")
							if vwc then
								vwc:Destroy()
							end
							v.Velocity = Vector3.new(math.random(30,70),math.random(30,70),math.random(30,70))
							v.RotVelocity = Vector3.new(math.random(30,70),math.random(30,70),math.random(30,70))
							
						end
						
					end
					
				end
					
				if dist(box,game.Players.LocalPlayer.Character.HumanoidRootPart) <= 5 then
					
					game.Players.LocalPlayer.Character.Humanoid.Health = game.Players.LocalPlayer.Character.Humanoid.Health-20
					
				end
					
					
				Boxes[currentBoxID]:Destroy()
			end)
		end
	end
	
end

local function spawnBox()
	if timestarted.Value == true then return end
	if Boxes[boxID] then
		Boxes[boxID]:Destroy()
	end
	local box = pushBox:Clone()
	box.Parent = pushBoxSpawnButton
	
	boxID = boxID + 1
	Boxes[boxID] = box
	
	local fuse = box:WaitForChild("Fuse")
	local click = fuse:WaitForChild("click")
	
	click.MouseClick:Connect(function()
		
		starttime(box)
		fuse.particle.Enabled = true
		box.Face.ImageLabel.Image = "http://www.roblox.com/asset/?id=3705592806"
		
	end)                                                          
	
end




return function()
	button.Touched:Connect(function(touch)
		if Players:GetPlayerFromCharacter(touch.Parent) == player and debounce == false then
			debounce = true
			spawnBox()
			
			wait(0.1)
			debounce = false
		end
	end)
	
	
	pushBox.Parent = nil
	
	
	if not script.Parent:FindFirstChild("DontSpawnFirst") then spawnBox() end
end
end))
