				local currentframe = plane.Engine.CFrame

				for i = 1,6 do
				body.cframe = plane.Engine.CFrame * CFrame.fromEulerAnglesXYZ(0, 0, 30)
				wait(.2)
				end

				body.cframe = currentframe
				wait(.6)

				body.maxTorque = Vector3.new(0, 0, 0)
				planedebounce = false
				plane.Parent.Stunt.Value = 0
				wait(3)
				stuntdebounce = false
			end
