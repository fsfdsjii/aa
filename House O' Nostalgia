function getPlayerFromPart(part)
	-- If part is inside a character, then return the player.  Else, return nil.
	while part do
		if part:FindFirstChild("Humanoid") then
			return game.Players:GetPlayerFromCharacter(part)
		end
		part = part.Parent
	end
	return nil
end

