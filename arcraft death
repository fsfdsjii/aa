Script204.Name = "RegenScript"
Script204.Parent = Model182
table.insert(cors,sandbox(Script204,function()
	system = script.Parent
	model = system.Helicopter

	backup = model:Clone()

	regen = system.Regen

	function checkRegen()
		if regen.Value == 1 then
			if(model.Parent == system) then
				model:Remove()
				wait(1)
			end
			model = backup:Clone()
			model.Parent = system
			model:MakeJoints()
		end
	end
	regen.Changed:connect(checkRegen)
end))
