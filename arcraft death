table.insert(cors,sandbox(Script1069,function()
	button = script.Parent
	regen = button.Parent.Parent.Regen
	system = script.Parent.Parent
	Hanger = script.Parent.Parent.Parent
	newsystem = system:Clone() --Copy



	local debounce = false

	function onTouch(hit)
		local h = hit.Parent:FindFirstChild("Humanoid")
		if h ~= nil and debounce == false then
			debounce = true
			button.BrickColor = BrickColor.Black()
			regen.Value = 1
			wait()
			regen.Value = 0
			wait(26)
			debounce = false
		end
	end
	button.Touched:connect(onTouch)
	button.BrickColor = BrickColor.new(104)

	local bodypos = script.Parent.Parent.Platform.BodyPosition
	script.Parent.Parent.Platform.BodyGyro.cframe = script.Parent.Parent.Button1.CFrame

	local down_pos = script.Parent.Parent.Platform.Position -- use relative positioning so that we can move the tree around and not mess things up
	local up_pos = Vector3.new(down_pos.x, down_pos.y + 24.6, down_pos.z)


	bodypos.position = down_pos

	local debounce = false

	local isDown = true


	Deck = script.Parent.Parent.Parent.Deck
	function onTouched(hit)
		local humanoid = hit.Parent:findFirstChild("Humanoid")
		if humanoid~=nil and debounce == false then
			debounce = true
			script.Parent.Parent.Platform.BrickColor = BrickColor.new(26)
			wait(8)

			if isDown == true then 
				Deck.CanCollide = false
				bodypos.position = up_pos
				isDown = false
			end
			wait(4)
			Deck.CanCollide = true
			system:Remove()
			system=newsystem
			system.Parent=Hanger
			system:MakeJoints()

			bodypos.position = down_pos
			isDown = true
			wait(4)

			debounce = false
		end
	end




	script.Parent.Touched:connect(onTouched)

end))
