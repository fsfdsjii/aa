	for i, plr in pairs(PlayersService:GetPlayers()) do

		if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character.Humanoid.Health > 0 then

			local hrp = plr.Character.HumanoidRootPart

			local distanceBetween = (sphere.Position - hrp.Position).Magnitude

			if not closestHRP then
				closestHRP = hrp
			end

			if (sphere.Position - closestHRP.Position).Magnitude > distanceBetween then

				closestHRP = hrp

			end
		end
	end

