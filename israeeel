local function AJEVQAC_fake_script() -- Quad4.Map_Script 
	local script = Instance.new('Script', Quad4)

	while true do
		task.wait()
		local p = game.Players:getChildren()
		for i = 1, #p do
			if p[i].Character.Torso ~= nil then
				local s = Instance.new("ImageLabel")
				s.Name = p[i].Name
				s.Parent = script.Parent
				if p[i].Name == script.Parent.Parent.Parent.Parent.Name then
					s.BorderColor = BrickColor.new("Bright blue")
				elseif p[i].TeamColor == script.Parent.Parent.Parent.Parent.TeamColor and script.Parent.Parent.Parent.Parent.Neutral == false then
					s.BorderColor = BrickColor.new("Bright green")
				elseif p[i].TeamColor ~= script.Parent.Parent.Parent.Parent.TeamColor and script.Parent.Parent.Parent.Parent.Neutral == false then
					s.BorderColor = BrickColor.new("Bright red")
				elseif p[i].TeamColor == script.Parent.Parent.Parent.Parent.TeamColor and script.Parent.Parent.Parent.Parent.Neutral == true then
					s.BorderColor = BrickColor.new("Bright red")
				elseif p[i].TeamColor ~= script.Parent.Parent.Parent.Parent.TeamColor and script.Parent.Parent.Parent.Parent.Neutral == true then
					s.BorderColor = BrickColor.new("Bright red")
				end
				s.Size = UDim2.new(0, 1, 0, 1)
				s.Position =  UDim2.new(0, p[i].Character.Torso.Position.x/4, 0, p[i].Character.Torso.Position.z/4)
			end
		end
		local e = game.Workspace:getChildren()
		if e ~= nil then
			for i = 1, #e do
				if e[i].Name == "Zombie" or e[i].Name == "Fohite Soldier" then
					local s = Instance.new("ImageLabel")
					s.Name = e[i].Name
					s.Parent = script.Parent
					s.BorderColor = BrickColor.new("Bright red")
					s.Size = UDim2.new(0, 1, 0, 1)
					s.Position =  UDim2.new(0, e[i].Torso.Position.x/4, 0, e[i].Torso.Position.z/4)
				end
			end
		end
		wait(0.5)
		local scans = script.Parent:getChildren()
		for i = 1, #scans do
			if scans[i] == script then
			else
				scans[i]:Remove()
			end
		end
	end
	
end
coroutine.wrap(AJEVQAC_fake_script)()
