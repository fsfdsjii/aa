				or 0
			local dy		=ry>sy and ry-sy
				or ry<-sy and ry+sy
				or 0
			local dz		=rz>sz and rz-sz
				or rz<-sz and rz+sz
				or 0
			return dx*dx+dy*dy+dz*dz<Radius*Radius
		end
