		local wasOutputEnabled = outputEnabled
		outputEnabled = false
		collectors[collector] = true

		local success, result = pcall(callback)

		collectors[collector] = nil
		outputEnabled = wasOutputEnabled

		assert(success, result)

		return collector
	end

