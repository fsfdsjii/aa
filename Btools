					end;

					-- Generate unique trigger ID
					local TriggerId = HttpService:GenerateGUID();

					-- Register timer
					Component.CurrentShowTimer = TriggerId;

					-- Start timer
					Delay(0.25, function ()
						if Component.CurrentShowTimer == TriggerId then
