Active = false
function NukeUp()
	local Radius = Region3.new(script.Parent.Position-Vector3.new(300,300,300),script.Parent.Position+Vector3.new(300,300,300))
	workspace.Terrain:FillBall(script.Parent.Position,600,Enum.Material.Air)
	local Parts = workspace:FindPartsInRegion3(Radius,script.Parent,9999999999)
	for z = 1, #Parts do
		Instance.new("Explosion",workspace).Position = Parts[z].Position
		local Random = math.random(1,5)
		if Random == 5 then
			Instance.new("Fire",Parts[z])
			Instance.new("Smoke",Parts[z]).Color = Color3.fromRGB(75,75,75)
		else
			local Dir = (Parts[z].Position-script.Parent.Position).unit
			local Pos = script.Parent.Position + Dir
			local LookAt = CFrame.new(Pos,Pos+Dir)
			Parts[z].Anchored = false
			Parts[z].Velocity = LookAt.lookVector*3000
		end
	end
	script.Parent.Anchored = true
	script.Parent.Transparency = 1
	script.Parent.CanCollide = false
	for x = 20, 360, 20 do
		local b = script.Parent.NuclearEffects.Blast:Clone()
		b.CFrame = CFrame.new(script.Parent.Position)*CFrame.fromEulerAnglesXYZ(0,math.rad(x),0)*CFrame.new(0,0,-300)
		b.ParticleEmitter.Enabled = true
		b.Parent = script.Parent
	end
	wait(1)
	for x = 20, 360, 20 do
		for c = 100, 150, 50 do
			local s = script.Parent.NuclearEffects.Smoke:Clone()
			s.CFrame = CFrame.new(script.Parent.Position)*CFrame.fromEulerAnglesXYZ(0,math.rad(x),0)*CFrame.new(0,0,-c)
			s.ParticleEmitter.Enabled = true
			s.Parent = script.Parent
		end
	end
	wait(5)
	local g = script.Parent:GetChildren()
	for c = 1, #g do
		if g[c].Name == "Blast" then
			g[c].ParticleEmitter.Enabled = false
			game:GetService("Debris"):AddItem(g[c],2)
		end
	end
	for c = 100, 600, 50 do
		local s = script.Parent.NuclearEffects.Smoke:Clone()
		s.CFrame = CFrame.new(script.Parent.Position)*CFrame.new(0,c,0)
		s.ParticleEmitter.Enabled = true
		s.Parent = script.Parent
		wait(0.25)
	end
	for x = 20, 360, 20 do
		for c = 100, 150, 50 do
			local s = script.Parent.NuclearEffects.Smoke:Clone()
			s.CFrame = CFrame.new(script.Parent.Position)*CFrame.fromEulerAnglesXYZ(0,math.rad(x),0)*CFrame.new(0,500,-c)
			s.ParticleEmitter.Enabled = true
			s.Parent = script.Parent
		end
	end
	wait(5)
	for x = 20, 360, 20 do
		for c = 100, 150, 50 do
			local s = script.Parent.NuclearEffects.Radioactive:Clone()
			s.CFrame = CFrame.new(script.Parent.Position)*CFrame.fromEulerAnglesXYZ(0,math.rad(x),0)*CFrame.new(0,0,-c)
			s.ParticleEmitter.Enabled = true
			s.Parent = script.Parent
		end
	end
	for v = 1, 1000 do
		wait(0.001)
		local rain = Instance.new("Part",workspace)
		rain.Material = Enum.Material.Granite
		rain.BrickColor = BrickColor.new("Really black")
		rain.Size = Vector3.new(1,3,1)
		rain.CFrame = CFrame.new(script.Parent.Position)*CFrame.new(0,600,0)*CFrame.new(math.random(-300,300),0,math.random(-300,300))
		rain.Touched:connect(function(h)
			h:BreakJoints()
			rain:Destroy()
		end)
	end
	wait(10)
	local g = script.Parent:GetChildren()
	for c = 1, #g do
		if g[c].Name == "Smoke" then
			g[c].ParticleEmitter.Enabled = false
			game:GetService("Debris"):AddItem(g[c],2)
		end
	end
end
script.Parent.Touched:connect(function()
	if Active == false then
		Active = true
		NukeUp()
	end
end)
