function DarkEffect(character)
	if not character then
		return
	end
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid then
		return
	end
	for i, v in pairs(character:GetChildren()) do
		if v:IsA("ForceField") then
			return
		end
	end
	local DarkEffectCopy = character:FindFirstChild(DarkEffectScript.Name)
	if DarkEffectCopy then
		return
	end
	DarkEffectCopy = DarkEffectScript:Clone()
	local Creator = Instance.new("ObjectValue")
	Creator.Name = "Creator"
	Creator.Value = Player
	Creator.Parent = DarkEffectCopy
	DarkEffectCopy.Disabled = false
	DarkEffectCopy.Parent = character
end

