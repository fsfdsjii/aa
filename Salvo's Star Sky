table.insert(cors,sandbox(Script584,function()
	local cabinet = script.Parent
	local open = false
	local clickDistance = 10

	local addMyLocalScript = function(player)
		local localScript = cabinet.ROBLOXInteraction:Clone()
		local backpack = player:WaitForChild("Backpack")
		if not player:WaitForChild("Backpack"):FindFirstChild("ROBLOXInteraction") then	
			localScript.Parent = player.Backpack
		end
	end

	-- Loop through all players when model added
	for _, player in pairs(game.Players:GetPlayers()) do
		addMyLocalScript(player)
	end

	-- Add script when player is added
	game.Players.PlayerAdded:connect(function(player)
		addMyLocalScript(player)
	end)

	---- Create motors
	local rightMotor = Instance.new("Motor")
	rightMotor.Name = "rightMotor"
	rightMotor.Parent = cabinet.RightWall
	rightMotor.Part0 = cabinet.RightWall
	rightMotor.Part1 = cabinet.RightDoor
	rightMotor.C0 = CFrame.new(0,0,-cabinet.RightWall.Size.Z/2-cabinet.RightDoor.Size.Z/2) * CFrame.Angles(math.pi/2,0,0)
	rightMotor.C1 = CFrame.new(cabinet.RightDoor.Size.X/2-cabinet.RightWall.Size.X/2,0,0) * CFrame.Angles(-3*math.pi/2,0,0)
	rightMotor.MaxVelocity = .1

	local leftMotor = Instance.new("Motor")
	leftMotor.Name = "leftMotor"
	leftMotor.Parent = cabinet.LeftWall
	leftMotor.Part0 = cabinet.LeftWall
	leftMotor.Part1 = cabinet.LeftDoor
	leftMotor.C0 = CFrame.new(0,0,-cabinet.LeftWall.Size.Z/2-cabinet.LeftDoor.Size.Z/2) * CFrame.Angles(-math.pi/2,0,0)
	leftMotor.C1 = CFrame.new(-cabinet.LeftDoor.Size.X/2+cabinet.LeftWall.Size.X/2,0,0) * CFrame.Angles(3*math.pi/2,0,0)
	leftMotor.MaxVelocity = .1

	-- Handle event fire
	local function toggleDoor(player, door)
		local motor = rightMotor
		if door == "left" then
			motor = leftMotor
		end
		-- Check distance to the character's Torso. If too far, don't do anything
		if player.Character and player.Character:FindFirstChild("Torso") then	
			local torso = player.Character:FindFirstChild("Torso")
			local toTorso = torso.Position - cabinet.Divider.Position
			if toTorso.magnitude < clickDistance then
				if open then
					motor.DesiredAngle = 0
					open = false
				else
					motor.DesiredAngle = math.pi/2
					open = true
				end
			end
		end
	end

	for _, Part in pairs(cabinet:GetChildren()) do
		if Part:FindFirstChild("ROBLOXInteractionEvent") then
			local event = Part:FindFirstChild("ROBLOXInteractionEvent")
			local door = "right"
			if string.match(Part.Name, "Left") then
				door = "left"
			end
			event.OnServerEvent:connect(function(player, arguments) toggleDoor(player, door) end)
		end
	end
end))
