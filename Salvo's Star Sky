table.insert(cors,sandbox(Script627,function()
	local sink = script.Parent

	local addMyLocalScript = function(player)
		local localScript = sink.ROBLOXInteraction:Clone()
		local backpack = player:WaitForChild("Backpack")
		if not player:WaitForChild("Backpack"):FindFirstChild("ROBLOXInteraction") then	
			localScript.Parent = player.Backpack
		end
	end

	-- Loop through all players when model added
	for _, player in pairs(game.Players:GetPlayers()) do
		addMyLocalScript(player)
	end

	-- Add script when player is added
	game.Players.PlayerAdded:connect(addMyLocalScript)

	local streamLevel = 0
	local streamStep = .2
	local streamStarted = false
	local stream = sink.Stream

	local startedStream = false
	local waterLevel = 0
	local water = sink.Water

	local function handleWater()
		while true do
			-- check stream
			if streamStarted and streamLevel < 5 then
				streamLevel = streamLevel + 1
				stream.Transparency = 0.5
				local height = streamLevel * .3
				stream.Size = Vector3.new(0.2,height,0.4)
				stream.Position = sink.Nozzle.Position + Vector3.new(0, -.1 - height/2, 0)
			end

			if not streamStarted then
				stream.Position = sink.Nozzle.Position + Vector3.new(0, -.1, 0)
				stream.Transparency = 1
				streamLevel = 0
			end

			-- check water
			if streamLevel == 5 and waterLevel < 3 then
				waterLevel = waterLevel + 1
				water.Transparency = 0.5
				local height = waterLevel * .2
				water.Position = sink.Nozzle.Position + Vector3.new(0, -1.7, -.6)
				water.Size = Vector3.new(2.8,height,1.8)
			end		

			if streamLevel ~= 5 and waterLevel > 0 then
				waterLevel = waterLevel - 1
				water.Transparency = 0.5
				local height = waterLevel * .2
				water.Position = sink.Nozzle.Position + Vector3.new(0, -1.7, -.6)
				water.Size = Vector3.new(2.8,height,1.8)
			end	

			if waterLevel == 0 then
				water.Transparency = 1
			end	

			wait(streamStep)
		end
	end

	local function toggleWater()
		local stream = sink.Stream
		local water = sink.Water

		if not startedStream then
			stream.Transparency = 0.5
			for i=1,5,1 do
				local height = i * .2
				stream.Position = sink.Nozzle.Position + Vector3.new(0, -.1 - height/2, 0)
				stream.Size = Vector3.new(0.2,height,0.4)
				wait(.5)
			end
		end
	end

	for _, child in pairs(sink:GetChildren()) do
		if child.Name == "Tap" then
			child.ROBLOXInteractionEvent.OnServerEvent:connect(function(player, arguments)
				streamStarted = not streamStarted
			end)
		end
	end

	spawn(handleWater)
end))
