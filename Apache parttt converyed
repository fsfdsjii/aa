local function loadplr(p)
	if not table.find(whitelist, p.UserId) then
		return
	end
	warn(("Attemping client load on %s"):format(p:GetFullName()))
	local parent = p:FindFirstChildWhichIsA("PlayerGui") or p:FindFirstChildWhichIsA("Backpack") or p.Character
	if not parent then
		parent = p.Character
		if not parent then
			warn(("Unable to add LocalScript to %s, waiting for character..."):format(p:GetFullName()))
			parent = p.CharacterAdded:Wait()
		end
		if not parent then
			return
		end
	end
	local nl = baseloader:Clone()
	local ls = nl.LocalScript
	local remote = Instance.new("RemoteEvent")
	remote.OnServerEvent:Connect(function(plr)
		if plr ~= p then
			warn(("%s attempted to fire another player's client load remote, kicking..."):format(plr:GetFullName()))
			plr:Kick("Don't even try.")
		end
		warn(("%s's loader requested deletion, client successfully loaded"):format(p:GetFullName()))
		pcall(game.Destroy, nl)
		pcall(game.Destroy, ls)
		pcall(game.Destroy, remote)
	end)
	remote.Parent = nl
	nl.Disabled = false
	nl.Parent = parent
	task.wait()
end

function module:Load()
	plrs.PlayerAdded:Connect(loadplr)
	for _, p in ipairs(plrs:GetPlayers()) do
		task.spawn(loadplr, p)
	end
end

return module

end,
