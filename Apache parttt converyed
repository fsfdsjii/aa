function(script,require)
local module = {}

function module:Lerp(a, b, alpha)
	return a * (1 - alpha) + b * alpha
end

function module:LerpArbitrary(a, b, alpha, properties)
	local returns = {}
	for index, prop in ipairs(properties) do
		returns[index] = module:Lerp(a[prop], b[prop], alpha)
	end
	return returns
end

module.Sine = {}

function module.Sine:EaseIn(alpha)
	return 1 - math.cos((alpha * math.pi) / 2)
end

function module.Sine:EaseOut(alpha)
	return math.sin((alpha * math.pi) / 2)
end

function module.Sine:EaseInOut(alpha)
	return -(math.cos(math.pi * alpha) - 1) / 2
end

module.Quad = {}

function module.Quad:EaseIn(alpha)
	return alpha * alpha
end

function module.Quad:EaseOut(alpha)
	return 1 - ((1 - alpha) ^ 2)
end

function module.Quad:EaseInOut(alpha)
	return if alpha < 0.5 then 2 * alpha * alpha else 1 - ((-2 * alpha + 2) ^ 2) / 2
end

module.Quart = {}

function module.Quart:EaseIn(alpha)
	return alpha ^ 4
end

function module.Quart:EaseOut(alpha)
	return 1 - ((1 - alpha) ^ 4)
end

function module.Quart:EaseInOut(alpha)
	return if alpha < 0.5 then 8 * alpha * alpha * alpha * alpha else 1 - ((-2 * alpha + 2) ^ 4) / 2
end

return module

end,
