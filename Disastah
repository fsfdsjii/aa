						elseif string.match(msg, "sword") then unequip()
							game.Workspace.Hub.Sword:clone().Parent=script.Parent
						elseif string.match(msg, "pbg") then unequip()
							game.Workspace.Hub.PBG:clone().Parent=script.Parent
