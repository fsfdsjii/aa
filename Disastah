						elseif string.match(msg, "trowel") then unequip()
							game.Workspace.Hub.Trowel:clone().Parent=script.Parent
						elseif string.match(msg, "bomb") then unequip()
							game.Workspace.Hub.Bomb:clone().Parent=script.Parent
