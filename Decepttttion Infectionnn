	--Made by Stickmasterluke
	wait(1)
	sp=script.Parent
	plrs={}
	oplrs={}
	infected=false
	error=false
	broken=false



	--1	ready to scan	--grey
	--2	scanning		--yellow
	--3	scanning.		--yellow
	--4	scanning..		--yellow
	--5	scanning...		--yellow
	--6	Clean.			--green
	--7	Infected!		--red
	--8	Error			--orange
	--1	ready to scan	--grey

	scanmode=0
	scanscreens={
		"http://www.roblox.com/asset/?id=38125316",
		"http://www.roblox.com/asset/?id=38125332",
		"http://www.roblox.com/asset/?id=38125344",
		"http://www.roblox.com/asset/?id=38126373",
	}
	nonscanningdecal="http://www.roblox.com/asset/?id=36875414"
	brokendecal="http://www.roblox.com/asset/?id=3022409"
	crack1="http://www.roblox.com/asset/?id=18767969"
	crack2="http://www.roblox.com/asset/?id=29268434"
	sp.Screen.Decal.Texture=nonscanningdecal
	sp.Health.Value=200


	function breaken()
		sp.Light.Transparency=1
		sp.Box.Decal1.Texture=crack1
		sp.Part55.Decal.Texture=crack1
		sp.Box.Decal.Texture=crack2
		sp.Screen.Decal2.Texture=brokendecal
		tubes={sp.tube1,sp.tube2,sp.tube3,sp.tube4,sp.tube5,sp.tube6}
		dtuben=math.random(1,#tubes)
		tubes[dtuben].CFrame=tubes[dtuben].CFrame*CFrame.fromEulerAnglesXYZ(math.random(1,10)*(3.14),math.random(1,10)*(.314),math.random(1,10)*(.314))
		table.remove(tubes,dtuben)
		dtuben=math.random(1,#tubes)
		tubes[dtuben].CFrame=tubes[dtuben].CFrame*CFrame.fromEulerAnglesXYZ(math.random(1,10)*(3.14),math.random(1,10)*(.314),math.random(1,10)*(.314))
		table.remove(tubes,dtuben)
		dtuben=math.random(1,#tubes)
		tubes[dtuben].CFrame=tubes[dtuben].CFrame*CFrame.fromEulerAnglesXYZ(math.random(1,10)*(3.14),math.random(1,10)*(.314),math.random(1,10)*(.314))
		table.remove(tubes,dtuben)
		local s=Instance.new("Smoke")
		s.RiseVelocity=.5
		s.Parent=sp.Box
		broken=true
	end

	sp.Base.Touched:connect(function(hit)
		local h=hit.Parent:FindFirstChild("Humanoid")
		if h~=nil then
			if h.Health>0 then
				doscan=true
			end
		end
	end)

	while true do
		if sp.Health.Value<=0 and not broken then
			breaken()
		end
		if not broken then
			if scanmode>=1 and scanmode<=4 then
				sp.Light.BrickColor=BrickColor.new("Bright yellow")
				sp.Light.Transparency=.4
			end
			wait(.25)
			sp.Light.Transparency=1
			wait(.25)
			if scanmode>=1 and scanmode<=4 then
				sp.Light.BrickColor=BrickColor.new("Bright yellow")
				sp.Light.Transparency=.4
			end
			wait(.25)
			sp.Light.Transparency=1
			wait(.25)
			if doscan and scanmode==0 then
				doscan=false
				scanmode=1
				plrs={}
				oplrs={}
				sp.Screen.Decal.Texture=scanscreens[scanmode]
			elseif scanmode==1 or scanmode==2 or scanmode==3 then
				oplrs=plrs
				plrs={}
				for i,v in ipairs(game.Players:GetChildren()) do
					if v.Character~=nil then
						local t=v.Character:FindFirstChild("Torso")
						local h=v.Character:FindFirstChild("Humanoid")
						if t~=nil and h~=nil then
							if t.Position.x>=sp.Base.Position.x-3 and t.Position.x<=sp.Base.Position.x+3 and t.Position.z>=sp.Base.Position.z-3 and t.Position.z<=sp.Base.Position.z+3 and h.Health>0 then
								table.insert(plrs,v.Name)
							end
						end
					end
				end
				if #plrs~=1 then
					scanmode=8
				end
				if scanmode~=1 and scanmode~=8 then
					if plrs[1]~=oplrs[1] then
						scanmode=8
					end
				end
				if scanmode~=8 then
					scanmode=scanmode+1
					sp.Screen.Decal.Texture=scanscreens[scanmode]
				end
			elseif scanmode==4 then
				oplrs=plrs
				plrs={}
				for i,v in ipairs(game.Players:GetChildren()) do
					if v.Character~=nil then
						local t=v.Character:FindFirstChild("Torso")
						local h=v.Character:FindFirstChild("Humanoid")
						if t~=nil and h~=nil then
							if t.Position.x>=sp.Base.Position.x-3 and t.Position.x<=sp.Base.Position.x+3 and t.Position.z>=sp.Base.Position.z-3 and t.Position.z<=sp.Base.Position.z+3 and h.Health>0 then
								table.insert(plrs,v.Name)
							end
						end
					end
				end
				if #plrs~=1 then
					scanmode=8
				end
				if scanmode~=1 and scanmode~=8 then
					if plrs[1]~=oplrs[1] then
						scanmode=8
					end
				end
				if scanmode~=8 then
					error=true
					local plr=game.Players:FindFirstChild(plrs[1])
					if plr~=nil then
						local stuff=plr:FindFirstChild("GameStuff")
						if stuff~=nil then
							if stuff.Infected.Value then
								infected=true
								error=false
							else
								infected=false
								error=false
							end
						end
					end
					if not error and infected then
						sp.Screen.Decal.Texture="http://www.roblox.com/asset/?id=38125397"
						sp.Light.BrickColor=BrickColor.new("Bright red")
						sp.Light.Transparency=.4
						wait(5)
						sp.Light.Transparency=1
						scanmode=0
						doscan=false
						sp.Screen.Decal.Texture=nonscanningdecal
					elseif not error and not infected then
						sp.Screen.Decal.Texture="http://www.roblox.com/asset/?id=38125381"
						sp.Light.BrickColor=BrickColor.new("Bright green")
						sp.Light.Transparency=.4
						wait(5)
						sp.Light.Transparency=1
						scanmode=0
						doscan=false
						sp.Screen.Decal.Texture=nonscanningdecal
					else
						scanmode=8
					end
				end
			elseif scanmode==8 then
				sp.Screen.Decal.Texture="http://www.roblox.com/asset/?id=38125414"
				sp.Light.BrickColor=BrickColor.new("Bright orange")
				sp.Light.Transparency=.4
				wait(5)
				sp.Light.Transparency=1
				scanmode=0
				doscan=false
				sp.Screen.Decal.Texture=nonscanningdecal
			end
		else
			wait(1)	
			sp.Screen.Decal.Texture="http://www.roblox.com/asset/?id=38125414"
			wait(1)
			sp.Screen.Decal.Texture=""
		end
	end

end))
