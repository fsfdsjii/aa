					if tag~=nil then
						local killer=findkiller(tag)
						if killer~=nil then
							tagsent=true
							local stats=killer:findFirstChild("leaderstats")
							local stuff2=killer:FindFirstChild("GameStuff")
							if stuff2~=nil and stats~=nil then
								if stuff.Infected.Value and not stuff2.Infected.Value then
									timetag(time,"killed",killer.Name,player.Name)
									if vipcheck(killer)==1 or vipcheck(killer)==3 then
										stats.Points.Value=stats.Points.Value+2
									else
										stats.Points.Value=stats.Points.Value+1
									end
								elseif not stuff2.Murdered.Value then
									stuff.Murdered.Value=true
									timetag(time,"murdered",killer.Name,player.Name)
									local char=killer.Character
									if char~=nil then
										local t=char:FindFirstChild("Torso")
										if t~=nil then
											t:remove()
										end
									end
									stats.Points.Value=stats.Points.Value-2
									if stats.Points.Value<=(-5) then
										killer:remove()
									end
								end
							end
						end
					end
					if not tagsent then
						timetag(time,"unknowndeath",player.Name)
					end
					stuff.Playing.Value=false
				end
			end
		end
	end

	function findkiller(tag)
		if tag~=nil then
			local killer=tag.Value
			if killer.Parent~=nil then
				return killer
			end
		end
		return nil
	end


