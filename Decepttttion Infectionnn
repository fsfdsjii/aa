	function fire(aim)
		sp.Handle.Fire:Play()

		t=r.Stepped:wait()
		last6=last5
		last5=last4
		last4=last3
		last3=last2
		last2=last
		last=t

		local bullet=Bullet:clone()
		local bt2=game.Lighting.BulletTexture:clone()
		bt2.BrickColor=BrickColor.new("New Yeller")
		bt2.Mesh.Scale=Vector3.new(.5,.5,2)
		local totalDist=0
		Lengthdist=-RayLength/.5
		local startpoint=myplr.Character.Head.Position --sp.Handle.CFrame*BarrlePos
		local fakestartpoint=sp.Handle.CFrame*BarrlePos
		local dir=(aim)-startpoint
		dir=computeDirection(dir)
		local dir2=(aim)-fakestartpoint
		dir2=computeDirection(dir2)
		local cfrm=CFrame.new(startpoint,dir+startpoint)
		local hit,pos,normal,time=raycast(game.Workspace, startpoint, cfrm*Vector3.new(0,0,Lengthdist)-startpoint, function(brick)
			if brick.Name=="Bullet" or brick.Name=="BulletTexture" then
				return false
			elseif brick:IsDescendantOf(sp.Parent) then
				return false
			elseif brick.Name=="Handle" then
				return false
			elseif brick.Name=="Blocker" then
				return false
			elseif brick.Transparency>=1 then
				return false
			end
			return true
		end)
		bullet.Parent=game.Workspace
		bt2.Parent=game.Workspace
		didhit=false
		if hit~=nil then
			distance=(fakestartpoint-pos).magnitude
			if hit.Name=="Water" or hit.Name=="Puddle" or hit.Name=="Spirt" then
				bt2.BrickColor=BrickColor.new("Bright blue")
				bt2.Transparency=.5
			elseif hit.Name=="Box" or hit.Name=="Blocker" or hit.Name=="Trunk" then
				bt2.BrickColor=hit.BrickColor
				bt2.Transparency=.1
			elseif hit.Name=="Pipeline" or hit.Name=="Vent" then
				p=Instance.new("Part")
				p.Transparency=1
				p.Size=Vector3.new(1,1,1)
				p.CanCollide=false
				p.Anchored=true
				p.CFrame=CFrame.new(fakestartpoint,dir2+fakestartpoint)*CFrame.new(0,0,-(distance+1))*CFrame.fromEulerAnglesXYZ(math.pi/2,0,0)
				p.Name="Steam"
				local s=Instance.new("Smoke")
				s.Color=Color3.new(204/255,236/255,1)
				s.Opacity=.5
				s.RiseVelocity=5
				s.Parent=p
				local rsc=sp.Remsc:clone()
				rsc.Parent=p
				rsc.Disabled=false
				p.Parent=game.Workspace
			end
			local humanoid=hit.Parent:FindFirstChild("Humanoid")
			if humanoid~=nil and game.Workspace.Leaderboard.Gameon.Value then
				if humanoid.Health>0 then
					tagHumanoid(humanoid)
					humanoid:TakeDamage(BaseDamage)
					didhit=true
				end
			end
			local mhp=hit.Parent:FindFirstChild("Health")
			if mhp~=nil and game.Workspace.Leaderboard.Gameon.Value then
				if mhp.className=="IntValue" then
					mhp.Value=mhp.Value-BaseDamage
				end
			end
			bullet.CFrame=CFrame.new(fakestartpoint,dir2+fakestartpoint)*CFrame.new(0,0,-distance/2)
			bullet.Mesh.Scale=Vector3.new(.15,.15,distance)
		else
			bullet.CFrame=CFrame.new(fakestartpoint,dir2+fakestartpoint)*CFrame.new(0,0,-RayLength/2) 
			bullet.Mesh.Scale=Vector3.new(.15,.15,RayLength)
		end
		if pos~=nil then
			if didhit then
				bt2.BrickColor=BrickColor.new("Bright red")
			end
			bt2.CFrame=bullet.CFrame
			movecframe(bt2,pos)
		end
		local deb=game:FindFirstChild("Debris")
		if deb==nil then
			local debris=Instance.new("Debris")
			debris.Parent=game
		end
		check()
		game.Debris:AddItem(bullet,.05)
		game.Debris:AddItem(bt2,.5)
	end

	function onButton1Up(mouse)
