		end
	end

	Tool.GripForward = Vector3.new(-0.976,0,-0.217)
	Tool.GripPos = Vector3.new(0.3,0,0)
	Tool.GripRight = Vector3.new(0.217,0,-0.976)
	Tool.GripUp = Vector3.new(0,1,0)
	if counter == 0 then
	Tool:remove()
	end

	enabled = true

end

function onEquipped()
	Tool.Handle.OpenSound:play()
end

