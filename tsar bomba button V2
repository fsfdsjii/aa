function Destruction(Pos,Radius)
	local function Destroy(Model)
		for i ,v in ipairs(Model:getChildren()) do
			if v.className == "Part" or v.className == "TrussPart" or v.className == "WedgePart" or v.className == "VehicleSeat" or v.className == "CornorWedgePart" or v.className == "Seat" then
				if (v.Position-Pos).magnitude < Radius then
					if v.Anchored == false then
						v:BreakJoints()
						v.Velocity = CFrame.new(v.Position,Pos):vectorToWorldSpace(Vector3.new(math.random(-5,5),5,200))
						v.Material = "CorrodedMetal"
					end	
				end
			elseif v.className == "Model" or v.className == "Hat" or v.className == "Tool" then
				Destroy(v)
			end
		end
	end
	for i ,v in ipairs(game.Workspace:GetChildren()) do	
		Destroy(v)
	end
end

