local Bin = script.Parent
local Core = Bin.Core
local TimeDis = Bin.Tsar
local Button = TimeDis.Head
local Sphere = Bin.Sphere
local Atom = Bin.Atom

local opened = false
local started = false
local exploded = false

TimeDis.Name = ""

function CountDown(num)

	local blargh = {"FIVE","FOUR","THREE!!","TWO!!","ONE!!!!!"}
	if num == 1 then
		script.Five:Play()
	elseif num == 2 then
		script.Four:Play()
	elseif num == 3 then
		script.Three:Play()
	elseif num == 4 then
		script.Two:Play()
	elseif num == 5 then
		script.One:Play()
	end
	
	for i , p in ipairs(game.Players:getChildren()) do
		if p.Character ~= nil then
			if p.Character:findFirstChild("Head") ~= nil then
				game:GetService("Chat"):Chat(p.Character.Head,blargh[num],Enum.ChatColor.Red)
			end
		end
	end
	print(num)
end

function Explode()
	local Pos = Instance.new("Vector3Value")
	Pos.Value = Core.Position
	Pos.Name = "Position"
	Pos.Parent = Atom
	Atom.Parent = game.Workspace
	Atom.Disabled = false
	Bin:remove()
end


function Open()
	if opened == false then
		opened = true
		for i = 1, 100 do
			wait()
			Button.CFrame = Button.CFrame+Vector3.new(0,-0.005,0)
		end
		delay(0,function()
			while exploded == false do
				wait()
				Core.CFrame = Core.CFrame*CFrame.Angles(math.rad(1),math.rad(1),math.rad(1))
			end
			Explode()
		end)
		for i = 1, 100 do
			wait()
			for index, ring in ipairs(Bin:getChildren()) do
				if ring.Name == "Ring" then
					ring.CFrame = ring.CFrame+Vector3.new(0,-0.025,0)
				end
			end
			Sphere.Transparency = Sphere.Transparency +0.01
		end
		Sphere:remove()
		for index, ring in ipairs(Bin:getChildren()) do
			if ring.Name == "Ring" then
				ring:remove()
			end
		end

				
		delay(0, function()
			if started == false then
				started = true
				for t = 60 , 4, -1 do
					wait(1)
					TimeDis.Name = t
				end
				TimeDis.Name = "FINAL COUNTDOWN"
				for c = 1, 5 do
					CountDown(c)
					wait(1)
				end
				exploded = true
			end
		end)
	end
end

Button.ClickDetector.MouseClick:connect(function() Open() end)	

end))
