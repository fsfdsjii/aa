	local lastpoint = table.remove(points, 1)
	local segments = {}
	for index, p in ipairs(points) do
		local new = ((index ~= #points) and lib.positions.getDeviance(p, deviance)) or p
		local seg = lib.effects.effectBetweenPoints(lastpoint, new)
		table.insert(segments, seg)
		lastpoint = new
	end
	return segments
end

