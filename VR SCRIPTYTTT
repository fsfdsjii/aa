	local ydev = rand:NextNumber(-dev, dev)
	local zdev = rand:NextNumber(-dev, dev)
	return Vector3.new(pos.X + xdev, pos.Y + ydev, pos.Z + zdev)
end

function lib.positions.getInnerPoints(point1: Vector3, point2: Vector3, pointamount: number): {Vector3}
	local points = {}
	local segmentdiv = 1 / pointamount

	local startcf = CFrame.new(point1)
	local endcf = CFrame.new(point2)

	for i = 0, 1, segmentdiv do
		table.insert(points, startcf:Lerp(endcf, i).Position)
	end
	return points
end

