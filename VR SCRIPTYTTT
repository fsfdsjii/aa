function lib.positions.alignUpVector(cframe: CFrame, upvector: Vector3): CFrame
	local start = cframe.UpVector
	local angle = math.acos(start:Dot(upvector))
	local axis
	if angle < 0.00001 or angle > math.pi - 0.00001 then
		axis = Vector3.xAxis
	else
		axis = start:Cross(upvector)
	end
	return CFrame.fromAxisAngle(axis, angle) * cframe.Rotation + cframe.Position
end

