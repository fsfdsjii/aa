	local mid = (point1 + point2) / 2
	local up = CFrame.lookAt(mid, point2).LookVector

	part.Size = Vector3.new(part.Size.X, mag, part.Size.Z)
	part.CFrame = lib.positions.alignUpVector(CFrame.new(mid), up)

	return mag, mid, up
end

function lib.effects.effectBetweenPoints(point1: Vector3, point2: Vector3): (Part, number, Vector3, Vector3)
