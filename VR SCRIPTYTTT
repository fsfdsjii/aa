	local lookvec = CFrame.lookAt(pos1, pos2).LookVector
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = blacklist or {}
	local ray = workspace:Raycast(pos1, lookvec * (mag + 1), params)
	if not ray and not ray.Instance then
		return true
	end
	return false
end

