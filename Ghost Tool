function anchor(a, p)
local f=p:children()
for i=1, #f do
if f[i].className=="Part" then
f[i].Anchored=a
end
end
end

function fade(p)
local f=p:children()

for g=1, 6 do
for i=1, #f do
if f[i].className=="Part" then
f[i].Transparency=f[i].Transparency+0.1
wait()
elseif f[i].className=="Hat" then
f[i].Handle.Transparency=f[i].Handle.Transparency+0.1
wait()
end
end
end
end

function unfade(p)
local f=p:children()
for g=1, 6 do
for i=1, #f do
if f[i].className=="Part" then
f[i].Transparency=f[i].Transparency-0.1
elseif f[i].className=="Hat" then
f[i].Handle.Transparency=f[i].Handle.Transparency-0.1
end
end
wait()
end
end

function tele(pos, p, k)
fade(p)
local d=Instance.new("Sparkles")
d.Parent=p.Torso
local s=script.Parent.BodyPosition:clone()
s.position=pos
s.Parent=p.Torso
while true do
wait()
if (p.Torso.Position-pos).magnitude<1 then
break
end
end
d:remove()
s:remove()
if k==true then
unfade(p)
end
end

