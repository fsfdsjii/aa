local RemoteName = GenerateString()
local RemoteKey = GenerateString()

local Remote = nil
local ClientReady = false
local RemoteEvents = {}
function are(e) table.insert(RemoteEvents,e) return e end
function FixRemote()
	ClientReady = false

	for _,e in ipairs(RemoteEvents) do e:Disconnect() end table.clear(RemoteEvents)
	if Remote then
		Debris:AddItem(Remote,0)
	end

	RunService.Heartbeat:Wait()

	Remote = Instance.new("RemoteEvent")
	Remote.Name = RemoteName

	are(Remote.DescendantAdded:Connect(FixRemote))
	are(Remote:GetPropertyChangedSignal("Name"):Connect(FixRemote))
	are(Remote.AncestryChanged:Connect(function()
		if Remote.Parent ~= Player then
			FixRemote()
		end
	end))

	are(Remote.OnServerEvent:Connect(function(plr,Key,Action,Data)
		if plr.UserId == Player.UserId and Key == RemoteKey then
			if Action == "Ready" then
				if Client then Client:Destroy() end
				ClientReady = true
			elseif Action == "SetState" and Data and typeof(Data) == "string" then
				if (ArrowState == "Equipped" and Data ~= "Equipped") or (ArrowState ~= "Equipped" and Data == "Equipped") then
					IgnoreNetwork = true
					IgnoreNetworkTimer = tick()

					if Arrow then
						coroutine.wrap(function()
							for _,d in ipairs(Arrow:GetDescendants()) do
								if d:IsA("BasePart") then
									pcall(function()
										d:SetNetworkOwner(Player)
									end)
								end
							end
							for i = 1,3 do
								RunService.Heartbeat:Wait()
							end
							for _,d in ipairs(Arrow:GetDescendants()) do
								if d:IsA("BasePart") then
									pcall(function()
										d:SetNetworkOwner(Player)
									end)
								end
							end
						end)()
					end
				end
				ArrowState = Data
			elseif Action == "Kill" and Data and typeof(Data) == "Instance" then
				xpcall(function()
					Data.Archivable = true
					local Body = Data:Clone()
					Debris:AddItem(Body,15)
					Data:BreakJoints()
					local Root = nil
					for _,d in ipairs(Data:GetDescendants()) do
						if d:IsA("BasePart") then
							if d.Name == "HumanoidRootPart" then
								Root = d
								d.Anchored = false
								d.CanCollide = false
								d.Transparency = 1
								d.Size = Vector3.new(0,0,0)

								pcall(function()
									Root:SetNetworkOwner(Player)
								end)
							else
								d:Destroy()
							end
						elseif d:IsA("Accessory") or d:IsA("Hat") then
							d:Destroy()
						end
					end
					Body.Parent = Workspace
					pcall(function()
						Body:FindFirstChildOfClass("Humanoid").RequiresNeck = false
						Body:FindFirstChildOfClass("Humanoid").PlatformStand = true
						Body:FindFirstChildOfClass("Humanoid"):SetAttribute("Dead", true)
					end)
					for i,v in ipairs(Body:GetDescendants()) do
						if v:IsA("Motor6D") and v.Parent.Name ~= "HumanoidRootPart" then
							local Socket = Instance.new("BallSocketConstraint")
							local a1 = Instance.new("Attachment")
							local a2 = Instance.new("Attachment")
							a1.Parent = v.Part0
							a2.Parent = v.Part1
							Socket.Parent = v.Parent
							Socket.Attachment0 = a1
							Socket.Attachment1 = a2
							a1.CFrame = v.C0
							a2.CFrame = v.C1
							Socket.LimitsEnabled = true
							Socket.TwistLimitsEnabled = true
							v:Destroy()
						end
					end
					local Colliders = {}
					for i,v in ipairs(Body:GetChildren()) do
						if v:IsA("BasePart") then
							if v.Name == "HumanoidRootPart" then
								pcall(function()
									local Weld = Instance.new("Weld",Root)
									Weld.Part0 = v
									Weld.Part1 = Root
								end)
							end
							pcall(function()
								v:SetNetworkOwner(Player)

								if not v.CanCollide then
									local Collider = Instance.new("Part",v)
									Collider.Transparency = 1
									Collider.Massless = true
									Collider.CustomPhysicalProperties = PhysicalProperties.new(0,0,0,0,0)
									Collider.Size = v.Size
									Collider.CFrame = v.CFrame
									Collider:SetNetworkOwner(Player)

									local Weld = Instance.new("Weld",v)
									Weld.Part0 = v
									Weld.Part1 = Collider

									table.insert(Colliders,Collider)

									pcall(function()
										local NCC = Instance.new("NoCollisionConstraint",Collider)
										NCC.Enabled = true
										NCC.Part0 = Collider
										NCC.Part1 = Root
									end)
								else
									pcall(function()
										local NCC = Instance.new("NoCollisionConstraint",v)
										NCC.Enabled = true
										NCC.Part0 = v
										NCC.Part1 = Root
									end)
								end

								v.Anchored = false

								local CF = Handle.CFrame * CFrame.Angles(0,math.rad(-90),0)
								if Data and typeof(Data) == "CFrame" then
									CF = Data
								end
								v.Velocity = CF.LookVector * 15
							end)
						end
					end

					for _,c in ipairs(Colliders) do
						for _,d in ipairs(Body:GetDescendants()) do
							pcall(function()
								if d:IsA("BasePart") then
									local NCC = Instance.new("NoCollisionConstraint",c)
									NCC.Enabled = true
									NCC.Part0 = c
									NCC.Part1 = d
								end
							end)
						end
					end
				end,function()
					Data:BreakJoints()
				end)
			elseif Action == "Refit" then
				FixArrow()
			end
		end
	end))

	Remote.Parent = Player
end
FixRemote()

function FireClient(...)
	coroutine.wrap(function(...)
		repeat RunService.Heartbeat:Wait() until Remote and Remote.Parent == Player and ClientReady
		pcall(function(...)
			Remote:FireClient(Player,RemoteKey,...)
		end,...)
	end)(...)
end

