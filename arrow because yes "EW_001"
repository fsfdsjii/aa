function FixArrow()
	Refitting = true

	for _,e in ipairs(ArrowEvents) do e:Disconnect() end table.clear(ArrowEvents)
	if Arrow then
		Debris:AddItem(Arrow,0)
	end

	RunService.Heartbeat:Wait()

	Arrow = ArrowTemplate:Clone()
	Handle = Arrow:WaitForChild("Handle")
	Top = Arrow:WaitForChild("Top")
	Trail = Arrow:WaitForChild("Trail")
	if Handle then
		EquipWeld = Handle:WaitForChild("EquipWeld")
		BodyPosition = Handle:WaitForChild("BodyPosition")
		BodyGyro = Handle:WaitForChild("BodyGyro")
	end

	Arrow.PrimaryPart = Handle
	xpcall(function()
		Arrow:SetPrimaryPartCFrame(GetRoot(Player.Character).CFrame * CFrame.Angles(0,math.rad(90),0))
	end,function()
		Arrow:SetPrimaryPartCFrame(CFrame.new() * CFrame.Angles(0,math.rad(90),0))
	end)

	BodyPosition.Position = Handle.Position
	BodyGyro.CFrame = Handle.CFrame

	local function Apply(d)
		d.Archivable = false
		--d.Name = tostring(GenerateString())

		aae(d.Changed:Connect(function(Property)
			if Refitting or Property == "NetworkOwnerV3" or Property == "NetworkIsSleeping" or Property == "NetworkOwnershipRuleBool" or Property == "NetworkOwnershipRule" then return end

			if Property == "Parent" and d == Arrow then
				if d.Parent ~= Terrain then
					FixArrow()
				end
			elseif Property == "Part0" and d == EquipWeld then
				if ArrowState == "Equipped" then
					if d.Part0 ~= GetNonRoot(Player.Character) then
						FixArrow()
					end
				else
					if d.Part0 ~= nil then
						FixArrow()
					end
				end
			elseif Property == "Enabled" and d == Trail then
				if ArrowState == "Attacking" or ArrowState == "ToIdle" or ArrowState == "Equipping1" or ArrowState == "Equipping2" then
					if d.Enabled ~= true then
						FixArrow()
					end
				else
					if d.Enabled ~= false then
						FixArrow()
					end
				end
			else
				FixArrow()
			end
		end))
	end

	Arrow.Name = tostring(GenerateString())
	Apply(Arrow)
	aae(Arrow.DescendantAdded:Connect(function()
		FixArrow()
	end))
	for _,d in ipairs(Arrow:GetDescendants()) do
		pcall(function()
			Apply(d)
		end)
	end

	Refitting = false
	Arrow.Parent = Terrain
	FireClient("SetArrow",Arrow)

	for _,d in ipairs(Arrow:GetDescendants()) do
		if d:IsA("BasePart") then
			pcall(function()
				d:SetNetworkOwner(Player)
			end)
		end
	end

	coroutine.wrap(function()
		repeat RunService.Heartbeat:Wait()
			if ArrowState ~= "Equipped" and not IgnoreNetwork then
				for _,d in ipairs(Arrow:GetDescendants()) do
					if Arrow.Parent ~= Terrain or Refitting then break end

					if d:IsA("BasePart") then
						pcall(function()
							if d:GetNetworkOwner() ~= Player or d:GetNetworkOwnershipAuto() then
								FixArrow()
							end
						end)
						RunService.Heartbeat:Wait()
					end
				end
			elseif IgnoreNetwork and tick() - IgnoreNetworkTimer >= 1 then
				IgnoreNetwork = false
			end
		until Arrow.Parent ~= Terrain or Refitting
	end)()
end
