local Client = nil

function GetRoot(c)
	local r = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("LowerTorso") or c:FindFirstChild("Head")
	if not r or not r:IsA("BasePart") then
		r = c:FindFirstChildWhichIsA("BasePart",true)
	end
	return r
end
function GetNonRoot(c)
	local r = c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("LowerTorso") or c:FindFirstChild("Head")
	if not r or not r:IsA("BasePart") then
		r = c:FindFirstChildWhichIsA("BasePart",true)
	end
	return r
end

