LocalScript183.Parent = Folder180
table.insert(cors,sandbox(LocalScript183,function()
	wait(1)
	local board = game.Workspace[script.BoardName.Value][script.BoardName.Value].SurfaceGui
	local events = board.Events

	--MUSIC BUTTON(S)
	local list = board.MenuFrame.MusicFrame.MusicList
	wait(1)
	function buttonconnect()
		for i,v in pairs (list:GetChildren()) do
			v.MouseButton1Down:connect(function()
				if v.Name ~= "AdditionButton" then
					events.MusicListButton:FireServer(v.Name)
				end
			end)
		end
	end
	buttonconnect()
	--CANCEL BUTTON(S)
	local currentsframe = board.MenuFrame.MusicFrame.MusicDisplay.CurrentsFrame
	currentsframe.ChildAdded:connect(function()
		for i,v in pairs (currentsframe:GetChildren()) do
			v:WaitForChild("Cancel").MouseButton1Down:connect(function()
				events.CancelButton:FireServer(v.Name)
			end)
		end
	end)

	local mf = board.MenuFrame.MusicFrame
	mf.Upward.MouseButton1Down:connect(function()
		for i,v in pairs (mf.MusicList:GetChildren()) do
			v:TweenPosition(UDim2.new(0,0,v.Position.Y.Scale+.78,0),"Out","Sine",.1,false)
		end
	end)
	mf.Downward.MouseButton1Down:connect(function()
		for i,v in pairs (mf.MusicList:GetChildren()) do
			v:TweenPosition(UDim2.new(0,0,v.Position.Y.Scale-.78,0),"Out","Sine",.1,false)
		end
	end)
	--MENU BUTTONS
	chframe = board.Choosing
	frameloc = board.MenuFrame
	function settingsmenu(don)
		for i,v in pairs (chframe:GetChildren()) do v.BackgroundColor3 = Color3.new(226/255, 226/255, 226/255) end
		chframe.SettingsMenu.BackgroundColor3 = Color3.new(1,1,1)
		frameloc.MusicFrame:TweenPosition(UDim2.new(0,0,-1,0),"Out","Sine",.22,false)
		frameloc.Settings:TweenPosition(UDim2.new(0,0,0,0),"Out","Sine",.22,false)
		frameloc.FeedbackFrame:TweenPosition(UDim2.new(0,0,1,0),"Out","Sine",.22,false)
		if don then
			board.Choosing.DonLab.Visible = false
		end
	end

	function musiclist()
		for i,v in pairs (chframe:GetChildren()) do v.BackgroundColor3 = Color3.new(226/255, 226/255, 226/255) end
		chframe.MusicList.BackgroundColor3 = Color3.new(1,1,1)
		frameloc.Settings:TweenPosition(UDim2.new(0,0,1,0),"Out","Sine",.22,false)
		frameloc.MusicFrame:TweenPosition(UDim2.new(0,0,0,0),"Out","Sine",.22,false)
		frameloc.FeedbackFrame:TweenPosition(UDim2.new(0,0,2,0),"Out","Sine",.22,false)
	end

	function feedback()
		for i,v in pairs (chframe:GetChildren()) do v.BackgroundColor3 = Color3.new(226/255, 226/255, 226/255) end
		chframe.FeedBack.BackgroundColor3 = Color3.new(1,1,1)
		frameloc.Settings:TweenPosition(UDim2.new(0,0,-2,0),"Out","Sine",.22,false)
		frameloc.MusicFrame:TweenPosition(UDim2.new(0,0,-1,0),"Out","Sine",.22,false)
		frameloc.FeedbackFrame:TweenPosition(UDim2.new(0,0,0,0),"Out","Sine",.22,false)
	end


	--butons
	chframe.FeedBack.MouseButton1Down:connect(function() feedback() end)
	chframe.MusicList.MouseButton1Down:connect(function() musiclist() end)
	chframe.SettingsMenu.MouseButton1Down:connect(function() settingsmenu(false) end)
	board.Choosing.DonLab.TextButton.MouseButton1Down:connect(function() settingsmenu(true) end)

	--PURCHASE EVENT(S)
	board.MenuFrame.MusicFrame.MusicDisplay.MainDisplayBox.TakeAudios.MouseButton1Down:connect(function()
		events.PurchaseAudios:FireServer()
	end)

	wait()
	if board:FindFirstChild("MainModule") then
		board.MainModule.PAE:FireServer(game.Players.LocalPlayer)
	end

	--SENDING TIME EVENT(S)
	events.Senders.LocalTimeLength.OnClientInvoke = function(songname,whatsplaying)
		print('board'.." "..songname.." "..whatsplaying)
		if board["Main(EDIT)"]:FindFirstChild(songname)[whatsplaying] then
			local g = board["Main(EDIT)"]:FindFirstChild(songname)[whatsplaying]
			return tonumber(g.TimeLength)
		else
			return 1
		end
	end

	events.Senders.LocalTotalLength.OnClientInvoke = function(songname)
		local num = 0
		for i,v in pairs (board["Main(EDIT)"][songname]:GetChildren()) do
			num = num + v.TimeLength
		end
		return tostring(num)
	end

	--LIVE TILE PURCHASE(S)
	local framesloc = board.MenuFrame.Settings.OtherFrame.LiveFrame.Frames:GetChildren()
	wait(1)
	for i,v in pairs (framesloc) do
		local name = v.Name
		v:WaitForChild("PurchaseButton").MouseButton1Down:connect(function()
			events.LiveTilePurchase:FireServer(game.Players.LocalPlayer, name)
		end)
	end

	local loc = board.MenuFrame.Settings.OtherFrame.Donations:GetChildren()
	for i,v in pairs (loc) do
		if v:IsA("TextButton") then
			local name = v.Name
			v.MouseButton1Down:connect(function()
				events.MarketEvent:FireServer(game.Players.LocalPlayer,tonumber(i))
			end)
		end
	end

	local coversong = 0
	local clickable = true
	board.MenuFrame.MusicFrame.MusicList:WaitForChild("AdditionButton").MouseButton1Down:connect(function()
		if not game.Players.LocalPlayer.PlayerGui:FindFirstChild("AddGui") and clickable == true then
			clickable = false
			local t = {}
			local gui = script.AddGui:Clone()
			gui.Parent = game.Players.LocalPlayer.PlayerGui
			gui.AddSongFrame.Visible = true
			gui.AddSongFrame.Exit.MouseButton1Down:connect(function()
				gui:Destroy()
			end)
			gui.AddSongFrame.Enter.MouseButton1Down:connect(function()
				for i,v in pairs (gui.AddSongFrame.Comps:GetChildren()) do
					if v.Text ~= "" and v.Text ~= " " and v.Text ~= "ID" and v.Name ~= "Name" then
						table.insert(t,v.Text)
					end
				end
				if gui.AddSongFrame:FindFirstChild("NameP") then
					if gui.AddSongFrame.NameP.Text == "Name" or gui.AddSongFrame.NameP.Text == "" or gui.AddSongFrame.NameP.Text == " " then
						coversong = coversong + 1
						table.insert(t,"BlankSong"..tostring(coversong))
					else
						table.insert(t,gui.AddSongFrame.NameP.Text)
					end
				end
				events.ReturningAddSong:FireServer(t)
				gui:Destroy()
			end)
			wait(1)
			clickable = true
			buttonconnect()
		end
	end)

	--button conncet loop
	spawn(function()
		while wait(5) do
			buttonconnect()
		end
	end)

	local df = board.MenuFrame.Settings.StyleFrame.DesignFrame
	df.CreateNewButton.MouseButton1Down:connect(function()
		if df.CreateNewButton.PhoCounterpart.Text == "-" then
			df.CreateNewButton.PhoCounterpart.Text = "+"
			for i,v in pairs (df.CreateNewFrame:GetChildren()) do
				v.Visible = false
			end
			df.CreateNewFrame:TweenSize(UDim2.new(0.45, 0,0, 0),"Out","Sine",.1,false)
		else
			df.CreateNewButton.PhoCounterpart.Text = "-"
			local curframe = 0
			curframe = curframe + 1
			for k,l in pairs (df.CreateNewFrame:FindFirstChild(tostring(curframe)):GetChildren()) do
				l.TextTransparency = 0
			end
			df.CreateNewFrame:TweenSize(UDim2.new(0.45, 0,0.36, 0),"Out","Sine",.1,false)
			wait(1/30)
			df.CreateNewFrame:FindFirstChild(tostring(curframe)).Visible = true
			df.CreateNewFrame.TextLabel.Visible = true
			for i,v in pairs (df.CreateNewFrame:FindFirstChild(tostring(curframe)):GetChildren()) do
				for i = 1, 0 do
					wait()
					v.TextTransparency = i
				end
			end
		end
	end)
end))
