table.insert(cors,sandbox(Script308,function()
	local debounce = true

	script.Parent.ClickDetector.MouseClick:connect(function(player)

		if debounce == true then
			debounce = false
			local player_character = game.Workspace[player.Name]

			local hat_name = "DJM Headphones"

			if player_character:FindFirstChild(hat_name) == nil then
				script.Parent.ClickDetector.MaxActivationDistance = 0
				local hat = Instance.new("Hat")

				local handle = Instance.new("Part")

				hat.Name = hat_name
				hat.Parent = player_character
				hat.AttachmentPos = Vector3.new(0, 0.15, 0)
				handle.Name = "Handle"
				handle.FormFactor = "Symmetric"
				handle.Size = Vector3.new(1, 1, 1)
				handle.TopSurface = "Smooth"
				handle.BottomSurface = "Smooth"
				handle.CanCollide = false
				handle.Locked = true
				handle.Position = player_character.Head.Position
				handle.Parent = hat
				script.Parent.Mesh:Clone().Parent = handle
				wait(0.5)
				script.Parent.ClickDetector.MaxActivationDistance = 20
			end
			debounce = true
		end

	end)

end))
