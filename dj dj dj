		script.Parent.Mesh.Offset = Vector3.new(0, -0.08, 0)

		for i, v in pairs(player_a) do
			if v:IsA("Sound") then
				v.Volume = (volume_a.Value / 100)
			end
		end

		for i, v in pairs(player_b) do
			if v:IsA("Sound") then
				v.Volume = (volume_b.Value / 100)
			end
		end

		wait(0.05)

		script.Parent.Material = Enum.Material.SmoothPlastic
		script.Parent.Mesh.Offset = Vector3.new(0, 0, 0)

	end)

end))
