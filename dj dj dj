table.insert(cors,sandbox(Script516,function()
	local player = script.Parent.Parent:WaitForChild("MusicPlayerB")

	local paused = script.Parent.TrackPaused

	local button = script.Parent.Pause

	script.Parent.TrackCurrent.Changed:connect(function()

		track_current = script.Parent.TrackCurrent.Value

		local track_prev = script.Parent.TrackPrev.Value

		if track_current > 0 then
			player["Track" ..track_current]:Play()
			if track_prev ~= track_current then
				player["Track" ..track_prev]:Stop()
				paused.Value = false
			end
		else
			player["Track" ..track_prev]:Stop()
			paused.Value = false
		end

	end)

	paused.Changed:connect(function()

		if paused.Value == true then
			player["Track" ..track_current]:Pause()
			button.Mesh.Offset = Vector3.new(0, -0.08, 0)
			button.Icon.Texture = "rbxassetid://210391009"
		else
			if track_current > 0 then
				player["Track" ..track_current]:Resume()
