		for i, v in pairs(speakers) do
			if v:IsA("Part") then
				v.Mesh.Offset = Vector3.new(0, -0.13, 0)
				wait(0.05)
				v.Mesh.Offset = Vector3.new(0, -0.19, 0)
			end
		end

	end

	function Off()

		for i, v in pairs(speakers) do
			if v:IsA("Part") then
				v.Mesh.Offset = Vector3.new(0, -0.19, 0)
			end
		end

	end

	track.Changed:connect(function()

		while track.Value > 0 do
			On()
		end
		Off()

	end)

end))
