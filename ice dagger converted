o1.Enabled = true
local last_attack = 0
function onActivated()

	if not o1.Enabled then
		return
	end

	o1.Enabled = false

	local character = o1.Parent;
	local humanoid = character.Humanoid
	if humanoid == nil then
		print("Humanoid not found")
		return 
	end

	local t = r.Stepped:wait()

	if (t - last_attack < .2) then
		lunge()
	else
		attack()
	end

	last_attack = t

	--wait(.5)

	o1.Enabled = true
end


function onEquipped()
	toggleDeadly(false)
	wait(3)
	toggleDeadly(true)
	UnsheathSound:play()
end


function onUnequipped()
	toggleDeadly(false)
end


