item = script.Parent.Item
price = script.Parent.Price
debounce = false
original = script.Parent.Head.BrickColor
--print("Hello World! Shopping script started")

function onTouch(part)
	h = part.Parent:findFirstChild("Humanoid")
	if h ~= nil then
		player = game.Players:findFirstChild(h.Parent.Name)
		if player ~= nil then
			stats = player:findFirstChild("leaderstats")
			if stats ~= nil then
				points = stats:findFirstChild("Coins")
				if points ~= nil then
					if points.Value >= price.Value and debounce == false and player.Backpack:findFirstChild(item.Value) == nil then
						debounce = true
						print("Go!")

						points.Value = points.Value - price.Value

						script.Parent.Head.BrickColor = BrickColor.new(21)

						bin = game.Lighting.Inventory:findFirstChild(item.Value):clone()
						bin.Parent = player.Backpack

						m = game.Workspace:findFirstChild(h.Parent.Name .. "'s Items")
						if m == nil then
							print("Making inventory")
							m = Instance.new("Model")
							m.Parent = game.Workspace
							m.Name = h.Parent.Name .. "'s Items"
							end

						i = item:clone()
						i.Parent = m
						i.Name = item.Value
						i.Value = ""

						print("Finished...")

						wait(3)

						script.Parent.Head.BrickColor = original
						debounce = false

						print("Kk")
						end
					end
				end
			end
		end
	end

script.Parent.Head.Touched:connect(onTouch)
end))
