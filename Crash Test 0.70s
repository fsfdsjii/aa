while true do Instance.new("GroundController" , workspace) end
function module.ChooseMiniGame()
	if not debounce then
		debounce = true
		local RandomGame = Gamemodes[math.random(1, #Gamemodes)]
		if RandomGame then
			local Map = RandomGame:Clone()
			Map.Parent = workspace
			Map.Name = "RoundMap"
			while true do	game.ReplicatedStorage:WaitForChild("EventHandlerRemote"):FireAllClients(Map.Name)
			end
			module.Start4Blocks(Map.Name)
		end
		wait(7)
		debounce = false
	end
end
