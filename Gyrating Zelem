local function AddArmor(character)
	if character:GetAttribute("ArmorAdded") == true then return end
	character:SetAttribute("ArmorAdded", true)
	character.Humanoid.HipHeight += 0.2
	for _, model in ipairs(ArmorTemplate.ArmorParts:GetChildren()) do
		local part0 = character:FindFirstChild(model.Name)
		if not part0 then continue end
		local base = ArmorTemplate.CharacterReference:FindFirstChild(model.Name)
		if not base then continue end
		for _, part1 in ipairs(model:GetChildren()) do
			if not part1:IsA("BasePart") then continue end
			part1 = part1:Clone()
			local weld = Instance.new("Weld")
			weld.C0 = base.CFrame:ToObjectSpace(part1.CFrame)
			weld.Part0 = part0
			weld.Part1 = part1
			weld.Name = "ArmorWeld"
			weld.Parent = part1
			part1.Name = "Armor_" .. model.Name
			part1.Anchored = false
			part1.CanCollide = false -- setting these to false
			part1.CanTouch = false -- will make sure the hitbox
			part1.CanQuery = false -- doesnt get affected negatively
			local oldTransparency = part1.Transparency
			part1.Transparency = 1
			part1.Parent = character
			TweenService:Create(
				part1,
				TweenInfo.new(0.5, Enum.EasingStyle.Linear),
				{Transparency = oldTransparency}
			):Play()
		end
	end
end

