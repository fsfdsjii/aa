	-- only show positive ints between 0 and a million
	if (num < 0) then num = -num end
	local score = num % math.pow(10,#digits)

	-- not the most efficient, but perhaps the most legible
	for i = #digits,1,-1 do

		local n = math.floor(score / math.pow(10,i-1))
		score = score - (n * math.pow(10,i-1))

		local v = Instance.new("IntValue")
		v.Value = n
		v.Parent = digits[i]

	end
	
