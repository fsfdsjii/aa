		if debounce == false then
			debounce = true
			switch.BrickColor = BrickColor.new(21)
			-- let slip the dogs of war
			fire(player)
			wait(.1)

			wait(0.5)
			debounce = false
			switch.BrickColor = BrickColor.new(37)
		end
	end


	script.Parent.ClickDetector.MouseClick:connect(onClicked)



end))
