				return
			end
			UntagHumanoid(humanoid)
			TagHumanoid(humanoid, CreatorPlayer)
			humanoid:TakeDamage(Damage)
		end
		Sounds.Hit:Play()
		Part:Destroy()
	end

	Part.Touched:connect(Touched)

	Debris:AddItem(Part, 5)
end

