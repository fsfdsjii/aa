eeee = Instance.new("Tool",owner.Backpack)
eeee.RequiresHandle = false
eeee.Name = "Rope Grab"

yyy = owner:FindFirstChild('yy')
if not yyy then
yy = Instance.new("RemoteEvent",owner)
yy.Name = "yy"
end

ropee = owner.Character["Right Arm"]:FindFirstChild('rope')
if not ropee then
rope = Instance.new("RopeConstraint",owner.Character["Right Arm"])
rope.Name = "rope"
rope.Attachment0 = owner.Character["Right Arm"].RightGripAttachment
