local function onchat(plr, msg)
	if not table.find(whitelist, plr.UserId) then
		return
	end
	local pf = msg:sub(1, #prefix)
	if pf ~= prefix then
		return
	end
	msg = msg:sub(#prefix + 1, #msg)
	local args = msg:split(sep)
	local cmd = table.remove(args, 1)
	if not cmd then
		return
	end
	if cmds[cmd] then
		return cmds[cmd](plr, args)
	end
end

