local function stopmod(mod: {Load: (Player) -> (nil), Stop: (nil) -> (nil)}, plr: Player)
	local plrrunning = running[plr]
	if not plrrunning then
		return
	end
	local idx = table.find(plrrunning, mod)
	if idx then
		table.remove(plrrunning, idx):Stop()
	end
end

local function stopmods(plr: Player)
	local plrrunning = running[plr]
	if not plrrunning then
		return
	end
	for idx, mod in ipairs(plrrunning) do
		plrrunning[idx] = nil
		mod:Stop()
	end
end

local function loadmod(mod: {Load: (Player) -> (nil), Stop: (nil) -> (nil)}, plr: Player)
	stopmod(mod, plr)
	local plrrunning = running[plr]
	if not plrrunning then
		plrrunning = {}
		running[plr] = plrrunning
	end
	table.insert(plrrunning, mod)
	mod:Load(plr)
end

local function connect(signal: RBXScriptSignal, callback: (any) -> (any), extraargs: {any})
	local newcallback
	if extraargs then
		function newcallback(...)
			return callback(unpack(extraargs), ...)
		end
	else
		newcallback = callback
	end
	local con = signal:Connect(newcallback)
	return con
end

local function getchardata(plrorcharacter: Model | Player)
	if plrorcharacter:IsA("Player") then
		plrorcharacter = plrorcharacter.Character
	end
	if not plrorcharacter then
		return {}
	end
	
	local data = {}
	data.char = plrorcharacter
	
	local hum = plrorcharacter:FindFirstChildWhichIsA("Humanoid")
	if hum then
		data.hum = hum
		local root = hum.RootPart
		if root then
			data.root = root
		end
	end
	return data
end

