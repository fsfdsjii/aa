local b64 = utils.base64

local rand = utils.random

local remote

local testservice = game:GetService("TestService")

local donesetup = false
local keylookup = {}

local remotename = b64.encode(game.JobId)

if remotename == "" then
	remotename = b64.encode("00000000-0000-0000-0000-000000000000")
end

local plrkey

local listeners = {}

local function onevent(key, ...)
	if plrkey ~= key then
		return
	end
	for _, l in ipairs(listeners) do
		if not l.Enabled then
			continue
		end
		task.spawn(l.Callback, ...)
	end
end

function socket.setup(key)
	if donesetup then
		return
	end
	socket.setup = function() end
	plrkey = b64.decode(key)
	task.spawn(function()
		while true do
			task.wait()
			if not remote or utils.isdestroyed(remote) then
				remote = testservice:WaitForChild(remotename)
