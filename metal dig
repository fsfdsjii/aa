rrr = Instance.new("Tool",owner.Backpack)
rrr.Name = "Subtract"

rrrr = Instance.new("Part",rrr)
rrrr.Name = "Handle"
rrrr.Size = Vector3.new(2, 1, 6)
rrrr.Massless = true
rrrr.Material = Enum.Material.Metal

rrr.Activated:Connect(function()
e = RaycastParams.new()
e.FilterDescendantsInstances = {owner.Character.HumanoidRootPart, owner.Character["Right Arm"], owner.Character.Torso, owner.Character["Left Arm"], owner.Character["Left Leg"], owner.Character["Right Leg"], rrrr}
v = workspace:Raycast(rrrr.Position, rrrr.Position * 3, e)
print(v)
if v ~= nil then
if v.Instance.ClassName == "Part" then
if v.Instance.ClassName ~= "MeshPart" then
e = v.Instance:SubtractAsync({rrrr})
e.Parent = v.Instance.Parent
e.Name = v.Instance.Name
v.Instance:Destroy()
            end
elseif v.Instance.ClassName == "UnionOperation" then
e = v.Instance:SubtractAsync({rrrr})
e.Parent = script
e.Name = v.Instance.Name
v.Instance:Destroy()
             end
        end
    end)

game:GetService('RunService').Heartbeat:Connect(function()
for i,v in script:GetDescendants() do
if v.Name == "Union" then v:Destroy() end end
end)
