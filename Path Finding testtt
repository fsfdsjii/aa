		sLanding.Volume = vol
		sLanding:Play()
		fallSpeed = 0
	end
	if speed>0.5 then
		sRunning:Play()
		sRunning.Pitch = 1.6
	else
		sRunning:Stop()
	end
	prevState = "Run"
end

