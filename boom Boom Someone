		msg = string.sub(msg, 4)

	end

	if string.sub(msg, 1, #"!setRadius ") == "!setRadius " then

		local newRadius = string.sub(msg, #"!setRadius "+1)

		if newRadius == "math.huge" or newRadius == "inf" then

			newRadius = math.huge

		end

		if tonumber(newRadius) == nil then

			warn("Argument must be a valid number.")

			return

		end

		radius = tonumber(newRadius)

