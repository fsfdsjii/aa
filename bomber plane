				local fly = script.FlyScript:clone()
				fly.Disabled = false
				fly.Parent = plane.Engine
			end
			if (key=="k") and planedebounce == false then
				wait()
				engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y -0.7, 0)
				wait()
				engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y -0.7, 0)
				wait()
				engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y -0.7, 0)
				wait()
				engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y -0.7, 0)
