function(script,require)
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")

local Robot = script.Parent

local Humanoid = Robot.Humanoid
local Owner = Robot:WaitForChild("Owner")

local Offset = Vector3.new(4, 0, 3)
local MovingAlongPath = false
local HasJump = false

function CastRay(start, direction, ignore)
	ignore = ignore or {}
	local NewRay = Ray.new(start, direction)
	
	return workspace:FindPartOnRayWithIgnoreList(NewRay, ignore)
end

function YieldUntilPointReached(point, timeout)
	local StartTime = tick()
	
	while tick() - StartTime < timeout and MovingAlongPath do
		local XZDistance = ((Humanoid.RootPart.Position - point) * Vector3.new(1, 0, 1)).Magnitude
		if XZDistance < 2 then
			return true
		end
		RunService.Heartbeat:wait()
	end
	
	return false
end

RunService.Heartbeat:Connect(function(delta)
	if not Owner.Value then return end
 
	local Start = Humanoid.RootPart.Position - Vector3.new(0, (Humanoid.RootPart.Size.y * 0.5) + 0.5, 0)
	local Finish = (Owner.Value.CFrame * CFrame.new(Offset)).p
	local Hit, EndPoint = CastRay(Start, (Owner.Value.Position - Start).Unit * 999, {Robot})
	if (Hit and Hit == Owner.Value) or (Hit and Hit.Parent and Hit.Parent:FindFirstChild(Owner.Value.Name) == Owner.Value) or not Hit then
		if not HasJump then
			MovingAlongPath = false
			Humanoid:MoveTo(Finish)
		end
	elseif not MovingAlongPath then
		HasJump = false
		MovingAlongPath = true
		-- // Pathfind
		local Path = PathfindingService:FindPathAsync((Humanoid.RootPart.CFrame * CFrame.new(0, 0, 0.5)).p, Finish)
		if Path and Path.Status == Enum.PathStatus.Success then
			MovingAlongPath = true
			
			for _, point in next, Path:GetWaypoints() do
				if point.Action == Enum.PathWaypointAction.Jump then
					HasJump = true
					break
				end
			end					
			
			for _, point in next, Path:GetWaypoints() do
				if MovingAlongPath == false then break end
 
				Humanoid:MoveTo(point.Position)
				if point.Action == Enum.PathWaypointAction.Jump then
					Humanoid.Jump = true
				end
				local Distance = ((point.Position - Humanoid.RootPart.Position) * Vector3.new(1, 0, 1)).Magnitude
				local ApproxTime = 10
				if Humanoid.WalkSpeed > 0 then
					ApproxTime = Distance / Humanoid.WalkSpeed
				end
				local DidReach = YieldUntilPointReached(point.Position, ApproxTime * 3 + 1)
				if not DidReach then
					break
				end
			end
		end
		HasJump = false
		MovingAlongPath = false
	end 
end)
end,
