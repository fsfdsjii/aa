function pizza(number, k)
	wait(2)

	for i = 1, 10 do
		k.Transparency = k.Transparency + 0.1
		k.CFrame = CFrame.new(k.Position + Vector3.new(math.random(-i * 0.1,i * 0.1), i * 0.1, math.random(-i * 0.1,i * 0.1)))
		wait(0.1)
	end

	k:Remove()
end
function okguys(b)
	r = game:service("RunService")

	shaft = b
	position = shaft.Position

	b.Explosion.PlayOnRemove = true -- play explosion sound when projectile removed from game


	function smoke(size, ahe)
		p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.TopSurface = 0
		p.BottomSurface = 0
		m = 1
		p.CFrame = CFrame.new(b.Position + (b.CFrame.lookVector * ahe) + Vector3.new(math.random(-m,m),math.random(-m,m),math.random(-m,m)))
		p.Shape = "Ball"
		p.Size = Vector3.new(size,size,size)
		pizza(0.1, p)
		p.Parent = game.Workspace
	end


	function fly()
		direction = shaft.CFrame.lookVector 
		position = position + direction * 8
		error = position - shaft.Position
		shaft.Velocity = 7*error
	end

	function blow(hit)
		if hit.CanCollide == false then return end
		shaft.Anchored = true
		swoosh:stop()
		explosion = Instance.new("Explosion")
		explosion.Position = shaft.Position
		explosion.BlastRadius = 12
		explosion.BlastPressure = 1000000


		-- find instigator tag
		local creator = b:findFirstChild("creator")
		if creator ~= nil then
			explosion.Hit:connect(function(part, distance)  onPlayerBlownUp(part, distance, creator) end)
		end

		explosion.Parent = game.Workspace
		b.Explosion:remove()
		connection:disconnect()
		shaft.Anchored = true
		shaft.CanCollide = false
		shaft.Transparency = 1
		for i = 1, 15 do
			if i > 8 then wait(0.01) end
			smoke(i * 3, i * 3.5)
		end
		shaft:remove()

	end

	function onPlayerBlownUp(part, distance, creator)

		if part.Name == "Head" then

			local humanoid = part.Parent.Humanoid
			tagHumanoid(humanoid, creator)
		end
	end

	function tagHumanoid(humanoid, creator)
		-- tag does not need to expire iff all explosions lethal

		if creator ~= nil then
			local new_tag = creator:clone()
			new_tag.Parent = humanoid

		end
	end

	function untagHumanoid(humanoid)
		if humanoid ~= nil then
			local tag = humanoid:findFirstChild("creator")
			if tag ~= nil then

				tag.Parent = nil
			end
		end
	end

	t, s = r.Stepped:wait()

