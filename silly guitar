-- Silly guitar: because you haven't lived until you've played music on a giant tongue.
math.randomseed(tick()); math.random()

local Tool = script.Parent
local Guitar = Tool.Handle
local playKey = Instance.new("RemoteEvent",Tool) -- Because of how remoteevents replicate throughout non-starterpack storage services, we will make a remoteevent. 
playKey.Name = "playKey"
local myHumanoid
local Torso
local TorsoWeld = {}

local StrumAnim
local ReadyAnim

local TimeTillEnabled
local WaitScript

local SongSound = Tool:FindFirstChild("SongSound")
local waitTime = 0
local timeWaited = 0
local stepTime = 0.1

local randNum

local noteTable = {
	["f"] = Guitar:FindFirstChild("C5"),
	["t"] = Guitar:FindFirstChild("CSharp5"),
	["g"] = Guitar:FindFirstChild("D5"),
	["y"] = Guitar:FindFirstChild("EFlat5"),
	["h"] = Guitar:FindFirstChild("E5"),
	["j"] = Guitar:FindFirstChild("F5"),
	["n"] = Guitar:FindFirstChild("FSharp5"),
	["k"] = Guitar:FindFirstChild("G5"),
	["m"] = Guitar:FindFirstChild("AFlat5"),
	["l"] = Guitar:FindFirstChild("A5"),
	["p"] = Guitar:FindFirstChild("BFlat5"),
	[";"] = Guitar:FindFirstChild("B5"),
	["'"] = Guitar:FindFirstChild("C6")
}

function reformGrip()
	for i = 1, 5 do	-- Game needs to be told quite a few times that we're serious about getting rid of RightGrip.
		local myCharacter = Tool.Parent
		local RightGrip
		Torso = myCharacter:FindFirstChild("Torso")
		RightArm = myCharacter:FindFirstChild("Right Arm")
		if RightArm then RightGrip = RightArm:FindFirstChild("RightGrip") end
		if Torso and not Torso:FindFirstChild("Silly Guitar Torso Weld") then
			if RightGrip then RightGrip.Parent = nil end
			Guitar.CanCollide = false
			local Welder = Instance.new("Weld")
			Welder.Part0 = Torso
			Welder.Part1 = Guitar
			Welder.C1 = CFrame.Angles(math.pi/2, math.pi, -math.pi/4) + Vector3.new(-0.2, 0.6, -0.4)
			Welder.Name = "Silly Guitar Torso Weld"
			Welder.Parent = Tool
			table.insert(TorsoWeld,Welder)
		end
		wait()
	end
end

function onActivated()
	-- Again, make sure character still has arms first.
	local myCharacter = Tool.Parent
	RightArm = myCharacter:FindFirstChild("Right Arm")
	LeftArm = myCharacter:FindFirstChild("Left Arm")
	if not (RightArm and LeftArm) then return end
	-- And that tool is enabled.
	if not Tool.Enabled then return end

	Tool.Enabled = false

	randNum = math.random()
	if (randNum < 1/3) then 
		SongSound = Guitar:FindFirstChild("Song1")
		waitTime = 11
		stepTime = 0.37
	elseif (randNum < 2/3) then 
		SongSound = Guitar:FindFirstChild("Song2")
		waitTime = 9.1
		stepTime = 0.52
	else 
		SongSound = Guitar:FindFirstChild("Song3")
		waitTime = 8.1
		stepTime = 0.49
	end

	SongSound:Play()
	timeWaited = 0
	while timeWaited < waitTime do
		if StrumAnim then StrumAnim:Play() end
		wait(stepTime)
		timeWaited = timeWaited + stepTime
	end

	Tool.Enabled = true
end

function play(player,key)
	--  Make sure character still has arms with which to play.
	local myCharacter = Tool.Parent
	RightArm = myCharacter:FindFirstChild("Right Arm")
	LeftArm = myCharacter:FindFirstChild("Left Arm")
	local Note = noteTable[key:lower()]
	if Note and RightArm and LeftArm then 
		if StrumAnim then StrumAnim:Play() end
		Note:Play() 
	end
end

function onEquipped(mouse)
	if mouse then mouse.KeyDown:connect(play) end

	local myCharacter = Tool.Parent
	-- Load animation nao, so we don't have to do it every time we play a note.
	myHumanoid = myCharacter:FindFirstChild("Humanoid")
	if myHumanoid then StrumAnim = myHumanoid:LoadAnimation(Tool.Strum) end

	-- And play the animation that gets us in position to strum.
	if myHumanoid then ReadyAnim = myHumanoid:LoadAnimation(Tool.GetGuitarReady) end
	if ReadyAnim then ReadyAnim:Play() end

	-- Break right grip, and weld guitar to torso instead.
	reformGrip()

end

function onUnequipped()
	-- Prepare to wait a while to re-enable if the unequip was via a backspace.
	
	for _, weld in ipairs(TorsoWeld) do
		if weld ~= nil then
			weld:Destroy()
		end
	end
	
	if (Tool.Parent == game.Workspace and not Tool:FindFirstChild("RunningWaitScript")) then
		TimeTillEnabled = Tool:FindFirstChild("TimeTillEnabled")
		if TimeTillEnabled then TimeTillEnabled.Value = waitTime - timeWaited end
		WaitScript = Tool:FindFirstChild("WaitScript")
		if WaitScript then
			WaitScript = WaitScript:Clone()
			WaitScript.Name = "RunningWaitScript"
			WaitScript.Parent = Tool
			WaitScript.Disabled = false
		end
	end

	if ReadyAnim then ReadyAnim:Stop() end
	StrumAnim = nil

	if Torso then
		Guitar.Position = Torso.Position + 8 * Torso.CFrame.lookVector + Vector3.new(0, 5, 0)
	else	
		Guitar.Position = Vector3.new(0, 5, 0)
	end
end

playKey.OnServerEvent:connect(play)
Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
end))
