--Made by Snap3rdbat, group with the model to get it to work. It's THAT easy! This button works for planes.
--If you are to change anything, change only the light-blue numbers unless you know what you're doing.

model = script.Parent.Parent--Indicates that the script interacts with the model the button is grouped with.
messageText = "Regenerating F7-mark nuker."--If you want a message to appear when pressed, type it here.

message = Instance.new("Message")
message.Text = messageText
backup = model:clone()
enabled = true

function regenerate()
	message.Parent = game.Workspace
	model:remove()

	wait(2)--Change this number to display the regen message as long as you want in seconds.

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil

	script.Disabled = true
	script.Parent.BrickColor = BrickColor.new(26)--Black
	wait(10)--Change this number to change the time in between regenerations by the button, either in seconds, or miliseconds (example: 0.11)..
	script.Parent.BrickColor = BrickColor.new(104)--Purple
	script.Disabled = false
end

function onHit(hit)
	if (hit.Parent:FindFirstChild("Humanoid") ~= nil) and enabled then
		regenerate()
	end
end

script.Parent.Touched:connect(onHit)

--It's Finished.
end))
